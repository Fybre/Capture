<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Capture.Core\Capture.Core.csproj" />
    <ProjectReference Include="..\Capture.Export\Capture.Export.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embedded in exported PDFs (invisible OCR text layer / PDF/A font-embedding requirement) —
         same IBM Plex Sans already bundled and licensed (SIL OFL) for the app's own UI. -->
    <EmbeddedResource Include="Resources\IBMPlexSans-Regular.ttf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.1.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>
</Project>
