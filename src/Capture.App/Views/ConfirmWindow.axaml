<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Capture.App.Views.ConfirmWindow"
        Icon="/Assets/capture.ico"
        Width="480"
        MinWidth="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid RowDefinitions="Auto,Auto" Background="{DynamicResource GroundBrush}">
        <StackPanel Grid.Row="0" Margin="24,22,24,10" Spacing="10">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12"
                Background="{DynamicResource Surface2Brush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" MinWidth="88" IsCancel="True" Click="OnCancelClick" />
                <Button x:Name="ConfirmButton" MinWidth="88" IsDefault="True" Click="OnConfirmClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
