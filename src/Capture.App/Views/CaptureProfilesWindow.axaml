<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Capture.App.ViewModels"
        x:Class="Capture.App.Views.CaptureProfilesWindow"
        x:DataType="vm:CaptureProfilesViewModel"
        Title="Capture Profiles" Width="620" Height="480" MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <TextBlock Text="Capture Profiles" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
    <ListBox Grid.Row="1"
             ItemsSource="{Binding Profiles}"
             SelectedItem="{Binding SelectedProfile}"
             DoubleTapped="OnProfileDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="8" ColumnSpacing="8">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="Disabled" Classes="hint" IsVisible="{Binding !Enabled}"/>
            <TextBlock Grid.Column="2" Text="{Binding DocumentTypes.Count, StringFormat={}{0} document types}" Classes="hint"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <WrapPanel>
        <Button Content="New" Command="{Binding NewCommand}" Margin="0,0,8,0"/>
        <Button Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,0"/>
        <Button Content="Delete" Command="{Binding DeleteCommand}" Classes="ghost" Margin="0,0,8,0"/>
        <Button Content="Export…" Command="{Binding ExportCommand}" Margin="0,0,8,0"
                ToolTip.Tip="Save the selected profile as a JSON file"/>
        <Button Content="Export all…" Command="{Binding ExportAllCommand}" Margin="0,0,8,0"
                ToolTip.Tip="Save every profile as JSON files in a folder"/>
        <Button Content="Import…" Command="{Binding ImportCommand}"
                ToolTip.Tip="Load a profile from a JSON file, as a new disabled draft"/>
      </WrapPanel>
      <Button Grid.Column="1"
              Content="Close"
              HorizontalAlignment="Right"
              IsCancel="True"
              Click="OnCloseClick"/>
    </Grid>
  </Grid>
</Window>
