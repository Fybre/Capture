<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Capture.App.Views.AboutWindow"
        Title="About Capture"
        Icon="/Assets/capture.ico"
        Width="620"
        Height="690"
        MinWidth="520"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Window.Styles>
        <Style Selector="Button.license-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.license-link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.license-link TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush1}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource GroundBrush}">
        <Border Grid.Row="0"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,22,28,18">
            <StackPanel HorizontalAlignment="Center" Spacing="7">
                <!-- The wordmark is intentionally presented on a light plaque: its navy lettering is
                     part of the supplied artwork, so this keeps it legible in both app themes. -->
                <Border Background="#F6FAFA"
                        BorderBrush="#D5E2E1"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18,10">
                    <Image Source="/Assets/Brand/Logo/capture-logo-512.png"
                           Width="290"
                           Height="80"
                           Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="VersionText"
                           Classes="hint"
                           FontSize="12.5"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,22" Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Document capture and indexing"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Capture is a desktop workspace for importing, scanning, indexing, reviewing, redacting, batching, and exporting documents."
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="RuntimeText"
                               Classes="hint"
                               FontSize="11.5"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Licensed under the" Classes="hint" FontSize="11.5" />
                        <Button Classes="license-link" Tag="https://www.apache.org/licenses/LICENSE-2.0" Click="OnLicenseLinkClick">
                            <TextBlock Text="Apache License, Version 2.0" FontSize="11.5" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Border Classes="card" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Third-party acknowledgements"
                                   Classes="section-title" />
                        <TextBlock Text="Capture is built with the following open-source software. Copyright remains with the respective authors."
                                   Classes="hint"
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Text="Avalonia UI 11.3.6" />
                            <Button Grid.Row="0" Grid.Column="1" Classes="license-link" Tag="https://opensource.org/license/mit" Click="OnLicenseLinkClick">
                                <TextBlock Text="MIT" />
                            </Button>

                            <TextBlock Grid.Row="1" Text="CommunityToolkit.Mvvm 8.4.2" Margin="0,7,0,0" />
                            <Button Grid.Row="1" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://opensource.org/license/mit" Click="OnLicenseLinkClick">
                                <TextBlock Text="MIT" />
                            </Button>

                            <TextBlock Grid.Row="2" Text="Microsoft .NET extensions and data libraries" Margin="0,7,0,0" />
                            <Button Grid.Row="2" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://opensource.org/license/mit" Click="OnLicenseLinkClick">
                                <TextBlock Text="MIT" />
                            </Button>

                            <TextBlock Grid.Row="3" Text="SQLite (via Microsoft.Data.Sqlite)" Margin="0,7,0,0" />
                            <Button Grid.Row="3" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://www.sqlite.org/copyright.html" Click="OnLicenseLinkClick">
                                <TextBlock Text="Public domain" />
                            </Button>

                            <TextBlock Grid.Row="4" Text="PdfPig 0.1.16" Margin="0,7,0,0" />
                            <Button Grid.Row="4" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://www.apache.org/licenses/LICENSE-2.0" Click="OnLicenseLinkClick">
                                <TextBlock Text="Apache 2.0" />
                            </Button>

                            <TextBlock Grid.Row="5" Text="PDFtoImage 5.1.1" Margin="0,7,0,0" />
                            <Button Grid.Row="5" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://opensource.org/license/mit" Click="OnLicenseLinkClick">
                                <TextBlock Text="MIT" />
                            </Button>

                            <TextBlock Grid.Row="6" Text="SkiaSharp 3.119.1" Margin="0,7,0,0" />
                            <Button Grid.Row="6" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://opensource.org/license/mit" Click="OnLicenseLinkClick">
                                <TextBlock Text="MIT" />
                            </Button>

                            <TextBlock Grid.Row="7" Text="ZXing.Net 0.16.9" Margin="0,7,0,0" />
                            <Button Grid.Row="7" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://www.apache.org/licenses/LICENSE-2.0" Click="OnLicenseLinkClick">
                                <TextBlock Text="Apache 2.0" />
                            </Button>

                            <TextBlock Grid.Row="8" Text="LLamaSharp and llama.cpp / ggml (local AI extraction)" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <Button Grid.Row="8" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://opensource.org/license/mit" Click="OnLicenseLinkClick">
                                <TextBlock Text="MIT" />
                            </Button>

                            <TextBlock Grid.Row="9" Text="Tesseract OCR and Leptonica" Margin="0,7,0,0" />
                            <Button Grid.Row="9" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://github.com/Fybre/tesseract-app/blob/main/licenses/THIRD-PARTY-NOTICES.md" Click="OnLicenseLinkClick">
                                <TextBlock Text="Apache 2.0 / BSD" />
                            </Button>

                            <TextBlock Grid.Row="10" Text="Microsoft Presidio, spaCy, and packaged sidecar dependencies" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <Button Grid.Row="10" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://github.com/Fybre/presidio-app" Click="OnLicenseLinkClick">
                                <TextBlock Text="MIT / BSD / Apache 2.0" />
                            </Button>

                            <TextBlock Grid.Row="11" Text="IBM Plex and Inter typefaces" Margin="0,7,0,0" />
                            <Button Grid.Row="11" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://openfontlicense.org" Click="OnLicenseLinkClick">
                                <TextBlock Text="SIL OFL 1.1" />
                            </Button>

                            <TextBlock Grid.Row="12" Text="Additional vcpkg-built image/compression/TLS libraries bundled with Tesseract (zlib, libpng, libjpeg-turbo, libtiff, and others)" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <Button Grid.Row="12" Grid.Column="1" Classes="license-link" Margin="18,7,0,0" Tag="https://github.com/Fybre/tesseract-app/blob/main/licenses/THIRD-PARTY-NOTICES.md" Click="OnLicenseLinkClick">
                                <TextBlock Text="BSD / MIT / zlib" />
                            </Button>
                        </Grid>

                        <TextBlock Text="Tap a license to view its full text. Some components include additional transitive dependencies and notices in their distributions."
                                   Classes="hint"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CopyrightText"
                           Classes="hint"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12"
                Background="{DynamicResource Surface2Brush}">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    MinWidth="88"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </Border>
    </Grid>
</Window>
