<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Capture.App.ViewModels"
             xmlns:controls="using:Capture.App.Controls"
             xmlns:batches="using:Capture.Core.Batches"
             x:Class="Capture.App.Views.ImportProfileDesignerView"
             x:DataType="vm:ImportProfileDesignerViewModel">
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource GroundBrush}">
        <Border Grid.Row="0"
                Padding="16,10"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush1}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Command="{Binding CloseCommand}" Classes="ghost">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform" Width="12" Height="12" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>
                <TextBox Grid.Column="1"
                         Text="{Binding Name}"
                         Watermark="Import profile name"
                         Margin="12,0"
                         VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Command="{Binding SaveCommand}"
                        Classes="accent">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="{StaticResource IconSave}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="420,*">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16" Spacing="14" HorizontalAlignment="Stretch">

                    <Border Classes="card" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Split incoming file when" Classes="section-title" />
                            <ComboBox ItemsSource="{Binding MatchModeOptions}"
                                      SelectedItem="{Binding MatchMode}"
                                      HorizontalAlignment="Stretch" />
                            <StackPanel Spacing="4" IsVisible="{Binding IsAtLeast}">
                                <TextBlock Text="Minimum strategies that must match" Classes="field-label" />
                                <NumericUpDown Value="{Binding MatchMinimum}" Minimum="1" Maximum="20" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <TextBlock Text="All = every strategy below must match this page. Any = at least one must match. At least N = a minimum count of them must match."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Strategies" Classes="section-title" />
                            <ListBox ItemsSource="{Binding Strategies}"
                                     SelectedItem="{Binding SelectedStrategy}"
                                     MaxHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SeparationStrategyRow">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding DisplayLabel}" FontWeight="Medium" />
                                                <TextBlock Text="(zone set)" Classes="hint" IsVisible="{Binding Zone, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Remove"
                                                    Classes="ghost"
                                                    Padding="6,2"
                                                    FontSize="11.5"
                                                    Command="{Binding $parent[ListBox].((vm:ImportProfileDesignerViewModel)DataContext).RemoveStrategyCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="+ Add strategy" Command="{Binding AddStrategyCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding SelectedStrategy, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Strategy" Classes="section-title" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Type" Classes="field-label" />
                                <ComboBox ItemsSource="{Binding StrategyTypeOptions}"
                                          SelectedItem="{Binding SelectedStrategy.Type}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Name (optional)" Classes="field-label" />
                                <TextBox Text="{Binding SelectedStrategy.Name}" Watermark="e.g. Cover barcode" />
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding SelectedStrategy.IsEveryNPages}">
                                <TextBlock Text="Pages per document" Classes="field-label" />
                                <NumericUpDown Value="{Binding SelectedStrategy.PageCount}" Minimum="1" Maximum="500" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding SelectedStrategy.IsBlankPage}">
                                <TextBlock Text="Blank page ink threshold (%)" Classes="field-label" />
                                <NumericUpDown Value="{Binding SelectedStrategy.BlankInkPercent}" Minimum="0" Maximum="100" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="10" IsVisible="{Binding SelectedStrategy.IsBarcode}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Barcode type" Classes="field-label" />
                                    <ComboBox ItemsSource="{Binding BarcodeFormatOptions}"
                                              SelectedItem="{Binding SelectedStrategy.BarcodeFormat}"
                                              PlaceholderText="Any format"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Barcode value to match" Classes="field-label" />
                                    <TextBox Text="{Binding SelectedStrategy.BarcodeValuePattern}" Watermark="Leave empty to match any value (regex)" />
                                    <TextBlock Text="This is a regex, not the literal value — drawing a zone auto-fills an exact-match pattern (^value$) for whatever's detected there. Edit or clear it to match more broadly."
                                               TextWrapping="Wrap"
                                               Classes="hint" />
                                </StackPanel>
                                <TextBlock Text="Load a sample document below and draw a rectangle around the barcode."
                                           TextWrapping="Wrap"
                                           Classes="hint" />
                            </StackPanel>

                            <StackPanel Spacing="10" IsVisible="{Binding SelectedStrategy.IsOcrZone}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Zone text to match" Classes="field-label" />
                                    <TextBox Text="{Binding SelectedStrategy.TextPattern}" Watermark="Leave empty to match any text in the zone (regex)" />
                                    <TextBlock Text="This is a regex — drawing a zone auto-fills an exact-match pattern (^text$) for whatever's detected there. Edit or clear it to match more broadly."
                                               TextWrapping="Wrap"
                                               Classes="hint" />
                                </StackPanel>
                                <TextBlock Text="Load a sample document below and draw a rectangle around the text to match."
                                           TextWrapping="Wrap"
                                           Classes="hint" />
                            </StackPanel>

                            <StackPanel Spacing="10" IsVisible="{Binding SelectedStrategy.IsRegex}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Whole-page text to match" Classes="field-label" />
                                    <TextBox Text="{Binding SelectedStrategy.TextPattern}" Watermark="Regex — required, matched against the whole page's text" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="10" IsVisible="{Binding SelectedStrategy.IsSimilarity}">
                                <TextBlock Text="Reference region" Classes="field-label" />
                                <TextBlock Text="Draw a rectangle below to mark the reference region on the sample."
                                           TextWrapping="Wrap"
                                           Classes="hint" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Similarity threshold" Classes="field-label" />
                                    <NumericUpDown Value="{Binding SelectedStrategy.SimilarityThreshold}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <Button Content="Compute reference embedding" IsEnabled="False" HorizontalAlignment="Left"
                                        ToolTip.Tip="Coming soon — needs an embedding model, not yet built." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Test strategies" Classes="section-title" />
                            <TextBlock Text="Runs every strategy above against the current sample page and shows each one's own result here — useful for checking that All/Any/At least N will actually produce the split decision you expect."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                            <Button Content="Test all against current sample" Command="{Binding TestAllStrategiesCommand}" HorizontalAlignment="Left" />
                            <ItemsControl ItemsSource="{Binding Strategies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SeparationStrategyRow">
                                        <Grid ColumnDefinitions="140,*" Margin="0,3">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TestResult, TargetNullValue='Not tested yet'}"
                                                       Classes="hint"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Discard separator page" Classes="section-title" />
                            <TextBlock Text="When checked, the page that made a strategy match is dropped from the resulting documents instead of kept as their first/last page. A page is discarded if any strategy that matched on it says so."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                            <ItemsControl ItemsSource="{Binding Strategies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SeparationStrategyRow">
                                        <CheckBox Content="{Binding DisplayLabel}"
                                                  IsChecked="{Binding DiscardSeparatorPage}"
                                                  IsVisible="{Binding !IsEveryNPages}"
                                                  Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sample document" Classes="section-title" />
                            <TextBlock Text="Shared by every strategy above that needs a drawn zone."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Choose sample…" Command="{Binding ChangeSampleCommand}" />
                                <TextBlock Text="{Binding SampleFileName}" VerticalAlignment="Center" Classes="field-label" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Batch profile" Classes="section-title" />
                            <TextBlock Text="Which batch profile documents from this import profile join. None falls back to the workspace default."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                            <ComboBox ItemsSource="{Binding BatchProfileOptions}"
                                      SelectedItem="{Binding SelectedBatchProfile}"
                                      PlaceholderText="None"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="batches:BatchProfile">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="New batch profile…"
                                    Command="{Binding ManageBatchProfilesCommand}"
                                    Classes="ghost"
                                    HorizontalAlignment="Left"
                                    Padding="8,4"
                                    FontSize="12.5" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" HorizontalAlignment="Stretch" Margin="0,0,0,40">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Valid indexing profiles" Classes="section-title" />
                            <TextBlock Text="Which indexing profiles apply to documents this import profile produces. Leave all unchecked to allow any."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                            <ItemsControl ItemsSource="{Binding IndexingProfileOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IndexingProfileOption">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="New indexing profile…"
                                    Command="{Binding ManageIndexingProfilesCommand}"
                                    Classes="ghost"
                                    HorizontalAlignment="Left"
                                    Padding="8,4"
                                    FontSize="12.5" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource CriticalBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasStatusText}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*"
                  Background="{DynamicResource SurfaceBrush}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,10">
                    <Button Classes="ghost nav" Command="{Binding PreviousPageCommand}">
                        <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform" Width="14" Height="14" Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Classes="mono"
                               Text="{Binding PageLabel}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="Medium" />
                    <Button Grid.Column="2" Classes="ghost nav" Command="{Binding NextPageCommand}">
                        <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform" Width="14" Height="14" Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6" />
                    </Button>
                </Grid>
                <Border Grid.Row="1"
                        Background="{DynamicResource Surface3Brush}"
                        BorderBrush="{DynamicResource BorderBrush1}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12,0,12,10"
                        ClipToBounds="True">
                    <controls:PagePreview PageImage="{Binding PageImage}"
                                          Highlights="{Binding Highlights}"
                                          AllowDraw="True"
                                          ZoneDrawnCommand="{Binding CompleteZoneCommand}"
                                          ZoneChangedCommand="{Binding ChangeZoneCommand}"
                                          Margin="8" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
