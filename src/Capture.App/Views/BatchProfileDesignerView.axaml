<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Capture.App.ViewModels"
             xmlns:controls="using:Capture.App.Controls"
             xmlns:profiles="using:Capture.Core.Profiles"
             x:Class="Capture.App.Views.BatchProfileDesignerView"
             x:DataType="vm:BatchProfileDesignerViewModel">
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource GroundBrush}">
        <Border Grid.Row="0"
                Padding="16,10"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush1}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Command="{Binding CloseCommand}" Classes="ghost">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform" Width="12" Height="12" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>
                <TextBox Grid.Column="1"
                         Text="{Binding Name}"
                         Watermark="Batch profile name"
                         Margin="12,0"
                         VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Command="{Binding SaveCommand}"
                        Classes="accent">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="{StaticResource IconSave}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="280" MaxWidth="700" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="300" MinWidth="220" MaxWidth="560" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16" Spacing="14" HorizontalAlignment="Stretch">

                    <Border Classes="card" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Text="New batch when" Classes="section-title" />
                            <ComboBox ItemsSource="{Binding ModeOptions}"
                                      SelectedItem="{Binding Mode}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Text="New batch per file starts a fresh batch for every imported file. Manual never starts one automatically — everything appends to whatever batch is already open. Use strategies unlocks the buildable condition list below."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="14" IsVisible="{Binding IsUseStrategies}">

                        <Border Classes="card" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Start a new batch when" Classes="section-title" />
                                <ComboBox ItemsSource="{Binding MatchModeOptions}"
                                          SelectedItem="{Binding MatchMode}"
                                          HorizontalAlignment="Stretch" />
                                <StackPanel Spacing="4" IsVisible="{Binding IsAtLeast}">
                                    <TextBlock Text="Minimum strategies that must match" Classes="field-label" />
                                    <NumericUpDown Value="{Binding MatchMinimum}" Minimum="1" Maximum="20" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <TextBlock Text="All = every strategy below must match this page. Any = at least one must match. At least N = a minimum count of them must match."
                                           TextWrapping="Wrap"
                                           Classes="hint" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Strategies" Classes="section-title" />
                                <ListBox ItemsSource="{Binding Strategies}"
                                         SelectedItem="{Binding SelectedStrategy}"
                                         MaxHeight="220">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SeparationStrategyRow">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="Medium" />
                                                    <TextBlock Text="(zone set)" Classes="hint" IsVisible="{Binding Zone, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Remove"
                                                        Classes="ghost"
                                                        Padding="6,2"
                                                        FontSize="11.5"
                                                        Command="{Binding $parent[ListBox].((vm:BatchProfileDesignerViewModel)DataContext).RemoveStrategyCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="+ Add strategy" Command="{Binding AddStrategyCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card"
                                HorizontalAlignment="Stretch"
                                IsVisible="{Binding SelectedStrategy, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Strategy" Classes="section-title" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Type" Classes="field-label" />
                                    <ComboBox ItemsSource="{Binding StrategyTypeOptions}"
                                              SelectedItem="{Binding SelectedStrategy.Type}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Name (optional)" Classes="field-label" />
                                    <TextBox Text="{Binding SelectedStrategy.Name}" Watermark="e.g. Cover sheet barcode" />
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding SelectedStrategy.IsEveryNPages}">
                                    <TextBlock Text="Pages per batch" Classes="field-label" />
                                    <NumericUpDown Value="{Binding SelectedStrategy.PageCount}" Minimum="1" Maximum="500" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Spacing="10" IsVisible="{Binding SelectedStrategy.IsBarcode}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Barcode type" Classes="field-label" />
                                        <ComboBox ItemsSource="{Binding BarcodeFormatOptions}"
                                                  SelectedItem="{Binding SelectedStrategy.BarcodeFormat}"
                                                  PlaceholderText="Any format"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Barcode value to match" Classes="field-label" />
                                        <TextBox Text="{Binding SelectedStrategy.BarcodeValuePattern}" Watermark="Leave empty to match any value (regex)" />
                                        <TextBlock Text="This is a regex, not the literal value — drawing a zone auto-fills an exact-match pattern (^value$) for whatever's detected there. Edit or clear it to match more broadly."
                                                   TextWrapping="Wrap"
                                                   Classes="hint" />
                                    </StackPanel>
                                    <TextBlock Text="Load a sample document below and draw a rectangle around the barcode."
                                               TextWrapping="Wrap"
                                               Classes="hint" />
                                </StackPanel>

                                <StackPanel Spacing="10" IsVisible="{Binding SelectedStrategy.IsOcrZone}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Zone text to match" Classes="field-label" />
                                        <TextBox Text="{Binding SelectedStrategy.TextPattern}" Watermark="Leave empty to match any text in the zone (regex)" />
                                        <TextBlock Text="This is a regex — drawing a zone auto-fills an exact-match pattern (^text$) for whatever's detected there. Edit or clear it to match more broadly."
                                                   TextWrapping="Wrap"
                                                   Classes="hint" />
                                    </StackPanel>
                                    <TextBlock Text="Load a sample document below and draw a rectangle around the text to match."
                                               TextWrapping="Wrap"
                                               Classes="hint" />
                                </StackPanel>

                                <StackPanel Spacing="10" IsVisible="{Binding SelectedStrategy.IsRegex}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Whole-page text to match" Classes="field-label" />
                                        <TextBox Text="{Binding SelectedStrategy.TextPattern}" Watermark="Regex — required, matched against the whole page's text" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Test strategies" Classes="section-title" />
                                <TextBlock Text="Runs every strategy above against the current sample page and shows each one's own result here — useful for checking that All/Any/At least N will actually produce the batch boundary you expect."
                                           TextWrapping="Wrap"
                                           Classes="hint" />
                                <Button Content="Test all against current sample" Command="{Binding TestAllStrategiesCommand}" HorizontalAlignment="Left" />
                                <ItemsControl ItemsSource="{Binding Strategies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SeparationStrategyRow">
                                            <Grid ColumnDefinitions="140,*" Margin="0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" FontWeight="Medium" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TestResult, TargetNullValue='Not tested yet'}"
                                                           Classes="hint"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Discard separator page" Classes="section-title" />
                                <TextBlock Text="When checked, the page that made a strategy match is dropped instead of kept at the batch boundary. A page is discarded if any strategy that matched on it says so."
                                           TextWrapping="Wrap"
                                           Classes="hint" />
                                <ItemsControl ItemsSource="{Binding Strategies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SeparationStrategyRow">
                                            <CheckBox Content="{Binding DisplayLabel}"
                                                      IsChecked="{Binding DiscardSeparatorPage}"
                                                      IsVisible="{Binding !IsEveryNPages}"
                                                      Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Sample document" Classes="section-title" />
                                <TextBlock Text="Shared by every strategy above that needs a drawn zone."
                                           TextWrapping="Wrap"
                                           Classes="hint" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Choose sample…" Command="{Binding ChangeSampleCommand}" />
                                    <TextBlock Text="{Binding SampleFileName}" VerticalAlignment="Center" Classes="field-label" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsUseStrategies}">

                        <Border Classes="card" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Batch fields" Classes="section-title" />
                                <TextBlock Text="Values captured once, at the moment a batch boundary is detected, and shared by every document that joins that batch — e.g. a Student No read from the same barcode/zone that separates batches. Configured here directly rather than by picking a separate Indexing Profile, using the same zone-drawing canvas as the Strategies above. The field list and its properties are on the right, alongside the sample preview."
                                           TextWrapping="Wrap"
                                           Classes="hint" />
                                <TextBlock Text="Add field" Classes="eyebrow" Margin="0,4,0,0" />
                                <Button Content="Zone"
                                        Command="{Binding AddZoneCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                                <Button Content="Barcode"
                                        Command="{Binding AddBarcodeCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                                <Button Content="Key/value"
                                        Command="{Binding AddKeyValueCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                                <Button Content="Regex"
                                        Command="{Binding AddRegexFieldCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                                <Button Content="Text"
                                        Command="{Binding AddTextCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                                <Button Content="Lookup"
                                        Command="{Binding AddLookupCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                                <Button Content="Script"
                                        Command="{Binding AddScriptFieldCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                                <Button Content="Button"
                                        Command="{Binding AddButtonFieldCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                                <Button Command="{Binding AddBatchSeparatorValueCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <TextBlock Text="Batch trigger value"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Test fields" Classes="section-title" />
                                <TextBlock Text="Runs every batch field above against the current sample page — the same extraction real batch-detection capture uses."
                                           TextWrapping="Wrap"
                                           Classes="hint" />
                                <Button Content="Test against current sample" Command="{Binding TestFieldsCommand}" HorizontalAlignment="Left" />
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FieldRow">
                                            <Grid ColumnDefinitions="140,*" Margin="0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LiveValue, TargetNullValue='Not tested yet'}"
                                                           Classes="hint"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Scripts" Classes="section-title" />
                                <TextBlock Text="Runs once per batch, right after fields above are populated — the same C# scripting Indexing Profiles use."
                                           TextWrapping="Wrap"
                                           Classes="hint" />
                                <TextBlock Text="Scripting is off in Settings — a saved script won't run during a real import yet."
                                           TextWrapping="Wrap"
                                           Classes="hint"
                                           Foreground="{DynamicResource CriticalBrush}"
                                           IsVisible="{Binding !IsScriptingAvailable}" />
                                <TextBlock Text="Shared functions" Classes="field-label" />
                                <TextBox Text="{Binding SharedScriptSource}"
                                         AcceptsReturn="True"
                                         Classes="mono"
                                         Height="60"
                                         Watermark="C# helpers available to every script below" />
                                <ItemsControl ItemsSource="{Binding Scripts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScriptRow">
                                            <Border Margin="0,0,0,8" Padding="8" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="Script name" />
                                                        <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding Enabled}" Margin="8,0,0,0" />
                                                    </Grid>
                                                    <ComboBox ItemsSource="{Binding $parent[ItemsControl].((vm:BatchProfileDesignerViewModel)DataContext).ScriptTriggerOptions}"
                                                              SelectedItem="{Binding Trigger}" />
                                                    <TextBox Text="{Binding Source}"
                                                             AcceptsReturn="True"
                                                             Classes="mono"
                                                             Height="70" />
                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                        <NumericUpDown Grid.Column="0" Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="120" HorizontalAlignment="Left" Width="120" />
                                                        <Button Grid.Column="1"
                                                                Content="Run test"
                                                                Command="{Binding $parent[ItemsControl].((vm:BatchProfileDesignerViewModel)DataContext).RunScriptTestCommand}"
                                                                CommandParameter="{Binding}"
                                                                Margin="6,0,0,0" />
                                                        <Button Grid.Column="2"
                                                                Content="Remove"
                                                                Classes="ghost"
                                                                Command="{Binding $parent[ItemsControl].((vm:BatchProfileDesignerViewModel)DataContext).RemoveScriptCommand}"
                                                                CommandParameter="{Binding}"
                                                                Margin="6,0,0,0" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="+ Add script" Command="{Binding AddScriptCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource CriticalBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasStatusText}" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          DragIncrement="1"
                          Background="Transparent"
                          Cursor="SizeWestEast"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsUseStrategies}" />
            <Border Grid.Column="1"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource BorderBrush1}"
                    IsHitTestVisible="False"
                    IsVisible="{Binding IsUseStrategies}" />

            <Grid Grid.Column="2"
                  RowDefinitions="Auto,*"
                  Background="{DynamicResource SurfaceBrush}"
                  IsVisible="{Binding IsUseStrategies}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,10">
                    <Button Classes="ghost nav" Command="{Binding PreviousPageCommand}">
                        <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform" Width="14" Height="14" Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Classes="mono"
                               Text="{Binding PageLabel}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="Medium" />
                    <Button Grid.Column="2" Classes="ghost nav" Command="{Binding NextPageCommand}">
                        <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform" Width="14" Height="14" Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6" />
                    </Button>
                </Grid>
                <Border Grid.Row="1"
                        Background="{DynamicResource Surface3Brush}"
                        BorderBrush="{DynamicResource BorderBrush1}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12,0,12,10"
                        ClipToBounds="True">
                    <Grid>
                        <controls:PagePreview PageImage="{Binding PageImage}"
                                              Highlights="{Binding Highlights}"
                                              OcrWords="{Binding CurrentPageWords}"
                                              ShowOcrWords="{Binding ShowOcrWords}"
                                              AllowDraw="True"
                                              ZoneDrawnCommand="{Binding CompleteZoneCommand}"
                                              ZoneChangedCommand="{Binding ChangeZoneCommand}"
                                              Margin="8" />
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush1}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="3"
                                IsVisible="{Binding PageImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <CheckBox Content="OCR text"
                                      IsChecked="{Binding ShowOcrWords}"
                                      VerticalAlignment="Center"
                                      Margin="6,0,4,0"
                                      FontSize="11.5"
                                      ToolTip.Tip="Show boxes around recognized text, to see why a zone or pattern draw did or didn't match" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          DragIncrement="1"
                          Background="Transparent"
                          Cursor="SizeWestEast"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsUseStrategies}" />
            <Border Grid.Column="3"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource BorderBrush1}"
                    IsHitTestVisible="False"
                    IsVisible="{Binding IsUseStrategies}" />

            <Grid Grid.Column="4"
                  RowDefinitions="*,5,*"
                  IsVisible="{Binding IsUseStrategies}">
                <TextBlock Grid.Row="0"
                           Text="Fields"
                           Classes="eyebrow"
                           Margin="16,14,16,8"
                           VerticalAlignment="Top" />
                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Fields}"
                         SelectedItem="{Binding SelectedField}"
                         BorderThickness="0"
                         Margin="8,34,8,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldRow">
                            <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding KindDisplay}" Classes="field-label" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Remove"
                                        Classes="ghost"
                                        Padding="6,2"
                                        FontSize="11.5"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                        Command="{Binding $parent[ListBox].((vm:BatchProfileDesignerViewModel)DataContext).RemoveFieldCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="1"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True"
                              Background="{DynamicResource BorderStrongBrush}"
                              Cursor="SizeNorthSouth"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              IsVisible="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <ScrollViewer Grid.Row="2" IsVisible="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="10" Margin="16,12">
                        <TextBlock Text="Field" Classes="section-title" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Name" Classes="field-label" />
                            <TextBox Text="{Binding SelectedField.Name}" />
                        </StackPanel>

                        <CheckBox Content="Mandatory" IsChecked="{Binding SelectedField.Mandatory}" />
                        <CheckBox Content="Sensitive" IsChecked="{Binding SelectedField.Sensitive}"
                                  ToolTip.Tip="Offers this field's value for redaction when a document's Indexing Profile has Redaction enabled." />
                        <CheckBox Content="Hidden" IsChecked="{Binding SelectedField.Hidden}"
                                  ToolTip.Tip="Excludes this field from the index grid and Ready/NeedsReview status checks." />

                        <StackPanel Spacing="4" IsVisible="{Binding SelectedField.IsBarcode}">
                            <TextBlock Text="Value pattern (optional)" Classes="field-label" />
                            <TextBox Text="{Binding SelectedField.ValuePattern}" Watermark="Leave empty for any barcode (regex)" />
                            <TextBlock Text="Draw a zone around the barcode, or leave it unset to scan the whole page."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding SelectedField.IsZonal}">
                            <TextBlock Text="Draw a zone on the page to the left."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding SelectedField.IsKeyValue}">
                            <TextBlock Text="Key pattern" Classes="field-label" />
                            <TextBox Text="{Binding SelectedField.KeyPattern}" Watermark="Invoice\s*No" />
                            <TextBlock Text="Value pattern" Classes="field-label" />
                            <TextBox Text="{Binding SelectedField.ValuePattern}" Watermark="\S+" />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding SelectedField.IsRegex}">
                            <TextBlock Text="Regex" Classes="field-label" />
                            <TextBox Text="{Binding SelectedField.ValuePattern}" Watermark="PO[-\s]?(\d+)" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding SelectedField.IsText}">
                            <TextBlock Text="Default value" Classes="field-label" />
                            <TextBox Text="{Binding SelectedField.DefaultValueTemplate}" Watermark="e.g. {Batch#|000}" />
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding SelectedField.IsLookup}">
                            <TextBlock Text="Options" Classes="field-label" />
                            <ItemsControl ItemsSource="{Binding SelectedField.LookupOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LookupOptionRow">
                                        <Border Margin="0,0,0,8" Padding="8" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <TextBox Text="{Binding Key}" Watermark="Display text" />
                                                <TextBox Text="{Binding Value}" Watermark="Export value" />
                                                <Button Content="Remove option" Command="{Binding RemoveCommand}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add option" Command="{Binding SelectedField.AddLookupOptionCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding SelectedField.IsScript}">
                            <TextBlock Text="Expression" Classes="field-label" />
                            <TextBox Text="{Binding SelectedField.ScriptExpression}"
                                     Watermark="Fields[&quot;Other Field&quot;].Value"
                                     AcceptsReturn="True"
                                     Classes="mono"
                                     Height="70" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding SelectedField.IsButton}">
                            <TextBlock Text="Button label" Classes="field-label" />
                            <TextBox Text="{Binding SelectedField.ButtonLabel}" Watermark="{Binding SelectedField.Name}" />
                            <TextBlock Text="Script" Classes="field-label" />
                            <TextBox Text="{Binding SelectedField.ButtonScriptSource}"
                                     AcceptsReturn="True"
                                     Classes="mono"
                                     Height="70" />
                        </StackPanel>

                        <TextBlock Text="Mirrors whichever strategy above triggers the batch — nothing else to configure."
                                   TextWrapping="Wrap"
                                   Classes="hint"
                                   IsVisible="{Binding SelectedField.IsBatchSeparatorValue}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
