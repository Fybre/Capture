<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Capture.App.ViewModels"
        x:Class="Capture.App.Views.ThereforeCategoryPickerWindow"
        x:DataType="vm:ThereforeCategoryPickerViewModel"
        Title="Choose a Therefore category"
        Width="760"
        Height="560"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto,Auto" Background="{DynamicResource GroundBrush}">
        <Grid Grid.Row="0" ColumnDefinitions="280,1,*" Margin="16">
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Categories" Classes="eyebrow" Margin="4,0,4,8" />
                <TreeView Grid.Row="1" ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <Button Grid.Row="2"
                        Content="Use this category →"
                        Command="{Binding UseCategoryCommand}"
                        Classes="accent"
                        HorizontalAlignment="Stretch"
                        Margin="4,10,4,0" />
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource BorderBrush1}" Margin="12,0" />

            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="{Binding SelectedCategoryName, TargetNullValue='Fields'}" Classes="eyebrow" Margin="4,0,4,8" />
                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="6" Margin="4,0">
                        <TextBlock Text="Pick a category and click &quot;Use this category&quot; to load its fields."
                                   TextWrapping="Wrap"
                                   Classes="hint"
                                   IsVisible="{Binding !HasFields}" />
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThereforeCategoryFieldRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Caption}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="Mandatory"
                                                   Foreground="{DynamicResource WarnBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding Mandatory}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TypeDisplay}"
                                                   Classes="mono"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Classes.critical="{Binding StatusIsError}"
                   TextWrapping="Wrap"
                   Margin="16,0,16,8"
                   IsVisible="{Binding HasStatusText}" />

        <Border Grid.Row="2"
                Padding="16,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush1}"
                Background="{DynamicResource Surface2Brush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Content="OK" Command="{Binding OkCommand}" Classes="accent" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
