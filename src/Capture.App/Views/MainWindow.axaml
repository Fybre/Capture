<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Capture.App.ViewModels"
        xmlns:controls="using:Capture.App.Controls"
        xmlns:conv="using:Capture.App.Converters"
        xmlns:profiles="using:Capture.Core.Profiles"
        xmlns:import="using:Capture.Core.Import"
        xmlns:redaction="using:Capture.Core.Redaction"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Capture.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/capture.ico"
        Title="Capture"
        Width="1280"
        Height="800"
        MinWidth="720"
        MinHeight="600">
    <Window.Resources>
        <!-- Icon glyphs live in Styles/Theme.axaml and resolve globally via StaticResource. -->

        <DataTemplate x:Key="IndexFieldTemplate" x:DataType="vm:IndexValueRow">
            <Button Classes="review-row"
                    Classes.selected="{Binding IsSelected}"
                    Command="{Binding SelectCommand}"
                    Margin="0,0,0,8"
                    ToolTip.Tip="Click to highlight this field's zone in the preview">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                        <Panel Grid.Column="1" IsVisible="{Binding !IsBatch}">
                            <Button Content="&#x2398;"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ApplyFieldToSelectionCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).HasMultipleSelectedDocuments}"
                                    Classes="ghost"
                                    Padding="4,0"
                                    Margin="0,0,4,0"
                                    FontSize="12"
                                    ToolTip.Tip="Copy this value into the same field on every other selected document" />
                        </Panel>
                        <TextBlock Grid.Column="2"
                                   Text="🔒"
                                   FontSize="11"
                                   Margin="0,0,6,0"
                                   IsVisible="{Binding IsReadOnly}"
                                   ToolTip.Tip="Read only" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Flag}"
                                   Foreground="{DynamicResource WarnBrush}"
                                   IsVisible="{Binding HasFlag}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Grid>
                    <TextBox Text="{Binding Text}"
                             IsVisible="{Binding IsTextEntry}"
                             IsEnabled="{Binding !IsReadOnly}"
                             Classes.invalid="{Binding HasFormatError}"
                             KeyDown="OnFieldKeyDown" />
                    <CalendarDatePicker SelectedDate="{Binding SelectedDate}"
                                        IsVisible="{Binding IsDate}"
                                        IsEnabled="{Binding !IsReadOnly}"
                                        HorizontalAlignment="Stretch"
                                        KeyDown="OnFieldKeyDown" />
                    <ComboBox ItemsSource="{Binding LookupChoices}"
                              SelectedItem="{Binding SelectedLookup}"
                              IsVisible="{Binding IsLookup}"
                              IsEnabled="{Binding !IsReadOnly}"
                              PlaceholderText="Choose a value"
                              HorizontalAlignment="Stretch"
                              KeyDown="OnFieldKeyDown">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LookupChoice">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel IsVisible="{Binding IsButton}" Spacing="4">
                        <Button Content="{Binding ButtonContent}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RunButtonFieldCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanRunButton}"
                                ToolTip.Tip="{Binding ButtonTooltip}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <TextBlock Text="{Binding ButtonStatus}"
                                   IsVisible="{Binding ButtonStatus, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                   TextWrapping="Wrap"
                                   Classes="hint" />
                    </StackPanel>
                    <ProgressBar Value="{Binding ConfidenceValue}"
                                 Maximum="100"
                                 Height="3"
                                 Margin="0,1,0,0"
                                 Classes.low="{Binding HasFlag}"
                                 IsVisible="{Binding !IsButton}"
                                 ToolTip.Tip="{Binding ConfidenceDisplay}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <Border Grid.Row="0"
                Padding="16,7"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush1}">
            <StackPanel Spacing="5">

                <!-- Row 1: view mode, one-shot actions -->
                <StackPanel Orientation="Horizontal">

                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="0,2,16,2">
                        <Image Source="avares://Capture.App/Assets/Brand/capture-icon-128.png"
                               Width="28" Height="28" Stretch="Uniform" />
                        <TextBlock Text="Capture" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource BorderBrush1}" Margin="0,6,16,6" />

                    <Border Classes="segment" VerticalAlignment="Center" Margin="0,2,16,2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="segment" Classes.accent="{Binding IsPreviewMode}" Command="{Binding ShowPreviewModeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource IconPreviewMode}" Stretch="Uniform" Width="13" Height="13" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                                    <TextBlock Text="Preview" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                            <Button Classes="segment" Classes.accent="{Binding IsTableMode}" Command="{Binding ShowTableModeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource IconTableMode}" Stretch="Uniform" Width="13" Height="13" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                                    <TextBlock Text="Table" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Classes="ghost"
                            Classes.accent="{Binding ShowTrash}"
                            Command="{Binding ToggleTrashViewCommand}"
                            VerticalAlignment="Center"
                            Margin="0,2,16,2"
                            IsVisible="{Binding IsTableMode}"
                            ToolTip.Tip="Documents removed until Trash retention expires — restore them, or delete them permanently">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{StaticResource IconDelete}" Stretch="Uniform" Width="13" Height="13" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                            <TextBlock Text="Trash" FontSize="12.5" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderBrush1}" Margin="0,6,16,6" />

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,16,2" IsVisible="{Binding !ShowTrash}">
                        <TextBlock Text="Import profile" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                        <ComboBox MinWidth="140"
                                  MaxWidth="190"
                                  Width="190"
                                  ItemsSource="{Binding ImportProfiles}"
                                  SelectedItem="{Binding SelectedImportProfile}"
                                  PlaceholderText="None"
                                  ToolTip.Tip="Import profile applied to manually imported files — controls how an incoming file gets split into documents, and which batch it joins.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="import:ImportProfile">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="ghost"
                                Width="22" Height="22" Padding="0" CornerRadius="6"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding ClearImportProfileCommand}"
                                IsVisible="{Binding SelectedImportProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                ToolTip.Tip="Clear import profile (use None)">
                            <TextBlock Text="×" FontSize="15" FontWeight="Medium" />
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource BorderBrush1}" Margin="0,6,16,6" />

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,16,2" IsVisible="{Binding !ShowTrash}">
                        <Button Command="{Binding ScanCommand}"
                                ToolTip.Tip="Scan a document from the first available scanner">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconScan}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelScanCommand}"
                                IsVisible="{Binding IsScanning}"
                                Classes="ghost"
                                Content="Cancel scan" />
                        <Button Command="{Binding ImportFilesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconImportFile}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Import files" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconImportFolder}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Import folder" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource BorderBrush1}" Margin="0,6,16,6" />

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,0,2">
                        <SplitButton Command="{Binding ExportCommand}"
                                     ToolTip.Tip="Export selected Ready documents, or all Ready documents when nothing is selected">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconExport}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[SplitButton].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Export" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Export all"
                                              Command="{Binding ExportAllCommand}"
                                              ToolTip.Tip="Export every Ready document in the inbox" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </StackPanel>
                </StackPanel>

                <!-- Row 2: active batch/profile selection — a subtly tinted band (bleeding past the
                     toolbar's own padding via negative margins) to visually separate it from Row 1's
                     one-shot actions above. -->
                <Border Background="{DynamicResource Surface2Brush}"
                        Margin="-16,3,-16,-7"
                        Padding="16,5,16,7">
                <DockPanel LastChildFill="False">

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" DockPanel.Dock="Right">
                        <Button Content="More ▾"
                                Classes="ghost"
                                FontSize="12.5"
                                Padding="9,5">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="2" MinWidth="180">
                                        <Button Command="{Binding OpenProfilesCommand}"
                                                Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Data="{StaticResource IconProfiles}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                                <TextBlock Text="Indexing profiles…" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding OpenBatchProfilesCommand}"
                                                Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Data="{StaticResource IconProfiles}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                                <TextBlock Text="Batch profiles…" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding OpenImportProfilesCommand}"
                                                Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Data="{StaticResource IconProfiles}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                                <TextBlock Text="Import profiles…" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding OpenSettingsCommand}"
                                                Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Data="{StaticResource IconSettings}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                                <TextBlock Text="Settings…" />
                                            </StackPanel>
                                        </Button>
                                        <Separator Margin="4,3" />
                                        <Button Command="{Binding OpenHelpCommand}"
                                                Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Data="M3,3.2 C3,2.5 3.5,2 4.2,2 L6.2,2 C7,2 7.6,2.3 8,2.9 C8.4,2.3 9,2 9.8,2 L11.8,2 C12.5,2 13,2.5 13,3.2 L13,11.5 C13,11.8 12.7,12 12.4,12 L9.7,12 C8.9,12 8.4,12.3 8,13 C7.6,12.3 7.1,12 6.3,12 L3.6,12 C3.3,12 3,11.8 3,11.5 Z M8,3 L8,11.5"
                                                      Stretch="Uniform"
                                                      Width="14"
                                                      Height="14"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeThickness="1.3"
                                                      StrokeLineCap="Round"
                                                      StrokeJoin="Round" />
                                                <TextBlock Text="Help…" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding OpenAboutCommand}"
                                                Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Data="M7,2 A5,5 0 1 1 7,12 A5,5 0 1 1 7,2 M7,6.2 L7,10 M7,4.2 L7,4.3"
                                                      Stretch="Uniform"
                                                      Width="14"
                                                      Height="14"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeThickness="1.4"
                                                      StrokeLineCap="Round" />
                                                <TextBlock Text="About Capture" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,16,2" DockPanel.Dock="Left">
                        <TextBlock Text="Indexing profile" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                        <ComboBox MinWidth="140"
                                  MaxWidth="190"
                                  Width="190"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedIndexingProfile}"
                                  PlaceholderText="None">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="profiles:IndexingProfile">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="ghost"
                                Width="22" Height="22" Padding="0" CornerRadius="6"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding ClearIndexingProfileCommand}"
                                IsVisible="{Binding SelectedIndexingProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                ToolTip.Tip="Clear indexing profile (use None)">
                            <TextBlock Text="×" FontSize="15" FontWeight="Medium" />
                        </Button>
                        <Button Command="{Binding ApplySelectedProfileCommand}"
                                CommandParameter="{Binding SelectedIndexingProfile}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconApply}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Apply profile" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource BorderBrush1}" Margin="0,6,16,6" DockPanel.Dock="Left" />

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,2,16,2" DockPanel.Dock="Left" IsVisible="{Binding !ShowTrash}">
                        <Border Classes="segment" Padding="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Command="{Binding MarkSelectedReadyCommand}"
                                        Classes="ghost"
                                        ToolTip.Tip="Mark the selected document(s) Ready — overrides low-confidence flags, but still skips a document with a missing required field">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{StaticResource IconCheck}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" />
                                        <TextBlock Text="Mark ready" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RedactSelectedCommand}"
                                        Classes="ghost"
                                        ToolTip.Tip="{Binding RedactSelectedTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{StaticResource IconRedact}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" />
                                        <TextBlock Text="Redact" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding MergeSelectedDocumentsCommand}"
                                        Classes="ghost"
                                        ToolTip.Tip="Merge the selected documents in their displayed order">
                                    <TextBlock Text="Merge" />
                                </Button>
                                <Button Command="{Binding RemoveSelectedCommand}"
                                        Classes="ghost"
                                        Foreground="{DynamicResource CriticalBrush}"
                                        ToolTip.Tip="Remove the selected document(s) (Delete)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{StaticResource IconRemove}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                        <TextBlock Text="Remove" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SelectedDocumentsSummary}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12"
                                   IsVisible="{Binding HasSelectedDocuments}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,2,16,2" DockPanel.Dock="Left" IsVisible="{Binding ShowTrash}">
                        <Border Classes="segment" Padding="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Command="{Binding RestoreSelectedTrashCommand}"
                                        Classes="ghost"
                                        ToolTip.Tip="Restore the selected document(s) out of Trash">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{StaticResource IconRestore}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                        <TextBlock Text="Restore" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding PurgeSelectedTrashCommand}"
                                        Classes="ghost"
                                        Foreground="{DynamicResource CriticalBrush}"
                                        ToolTip.Tip="Permanently delete the selected document(s) — cannot be undone">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{StaticResource IconDelete}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                        <TextBlock Text="Delete permanently" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SelectedDocumentsSummary}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12"
                                   IsVisible="{Binding HasSelectedDocuments}" />
                    </StackPanel>
                </DockPanel>
                </Border>

                <Border IsVisible="{Binding IsRedactPickerOpen}"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush1}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Redact now — choose which redaction set to use"
                                   FontWeight="Medium"
                                   FontSize="12.5" />
                        <ListBox ItemsSource="{Binding RedactEntitySetOptions}"
                                 SelectedItem="{Binding SelectedRedactEntitySet}"
                                 SelectionMode="Single"
                                 Background="Transparent"
                                 Padding="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="Margin" Value="0,0,8,6" />
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="redaction:RedactionEntitySet">
                                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Entities, Converter={x:Static conv:EntityListSummaryConverter.Instance}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Manage redaction sets from Settings."
                                   FontSize="11"
                                   Foreground="{DynamicResource FaintBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Redact" Command="{Binding ConfirmRedactCommand}" />
                            <Button Content="Cancel" Classes="ghost" Command="{Binding CancelRedactCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource GroundBrush}" IsVisible="{Binding IsPreviewMode}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180" MaxWidth="560" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="292" MinWidth="220" MaxWidth="560" />
            </Grid.ColumnDefinitions>
            <!-- Inbox -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,16,8">
                    <TextBlock Text="Inbox" Classes="eyebrow" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Classes="mono"
                               Text="{Binding Documents.Count, StringFormat='{}{0} documents'}"
                               Foreground="{DynamicResource FaintBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" Margin="8,0">
                    <DataGrid x:Name="InboxGrid"
                              ItemsSource="{Binding Documents}"
                              SelectedItem="{Binding SelectedDocument}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionChanged="OnInboxSelectionChanged"
                              GridLinesVisibility="None"
                              HeadersVisibility="None"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="True"
                              BorderThickness="0"
                              RowHeight="46"
                              DragDrop.AllowDrop="True">
                        <DataGrid.KeyBindings>
                            <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedCommand}" />
                            <KeyBinding Gesture="Back" Command="{Binding RemoveSelectedCommand}" />
                        </DataGrid.KeyBindings>
                        <DataGrid.Styles>
                            <Style Selector="DataGridRow" x:DataType="vm:DocumentRow">
                                <Setter Property="(DragDrop.AllowDrop)" Value="True" />
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="4" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DocumentRow">
                                        <Border CornerRadius="2"
                                                Margin="0,3"
                                                Background="{Binding BatchAccent, Converter={x:Static conv:BatchAccentBrushConverter.Instance}, ConverterParameter=bar}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" CanUserSort="True" SortMemberPath="FileName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DocumentRow">
                                        <StackPanel Spacing="4" Margin="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Classes="chip"
                                                        Classes.chip-ready="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsReady}}"
                                                        Classes.chip-review="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsReview}}"
                                                        Classes.chip-error="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsError}}"
                                                        Classes.chip-neutral="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsNeutral}}">
                                                    <TextBlock Text="{Binding StatusDisplay}" />
                                                </Border>
                                                <TextBlock Text="{Binding IssueDisplay}"
                                                           Classes="mono"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource CriticalBrush}"
                                                           IsVisible="{Binding IssueDisplay, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding RedactionStatusDisplay}"
                                                           Classes="mono"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           IsVisible="{Binding RedactionStatusDisplay, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="Duplicate"
                                                           Classes="mono"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           IsVisible="{Binding IsDuplicate}"
                                                           ToolTip.Tip="{Binding DuplicateTooltip}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Import a PDF or image to get started"
                               IsVisible="{Binding HasNoDocuments}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="24"
                               TextAlignment="Center" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          DragIncrement="1"
                          Background="Transparent"
                          Cursor="SizeWestEast"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
            <Border Grid.Column="1"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource BorderBrush1}"
                    IsHitTestVisible="False" />

            <!-- Preview -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" ColumnDefinitions="80,*" Background="{DynamicResource SurfaceBrush}">
                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" Margin="8,10,12,10">
                    <Button Classes="ghost"
                            Command="{Binding PreviousPageCommand}"
                            Width="30" Height="30" Padding="0" CornerRadius="7"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform" Width="14" Height="14" Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Classes="mono"
                               Text="{Binding PageLabel}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="Medium" />
                    <Button Grid.Column="2"
                            Classes="ghost"
                            Command="{Binding NextPageCommand}"
                            Width="30" Height="30" Padding="0" CornerRadius="7"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform" Width="14" Height="14" Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="0"
                              Grid.RowSpan="3"
                              Grid.Column="0"
                              Margin="8,10,0,10"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="PageThumbnailStrip"
                                 ItemsSource="{Binding PageThumbnails}"
                                 SelectedItems="{Binding SelectedPageThumbnails}"
                                 SelectionMode="Multiple"
                                 Background="Transparent"
                                 Padding="0"
                                 IsEnabled="{Binding !IsBusy}"
                                 SelectionChanged="OnPageThumbnailSelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                                </Style>
                                <!-- Avalonia's default theme applies no visual treatment to a disabled ListBox
                                     (confirmed: identical pixels idle vs. busy without this) — without an
                                     explicit dim, the strip would look normal and still draggable while
                                     IsEnabled="False" silently blocks input, worse than no gate at all. -->
                                <Style Selector="ListBoxItem:disabled">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PageThumbnailRow">
                                    <Border Width="56"
                                            Height="72"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush1}"
                                            BorderThickness="1"
                                            ContextRequested="OnPageThumbnailContextRequested">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete page(s)"
                                                          Command="{Binding #PageThumbnailStrip.((vm:MainViewModel)DataContext).DeleteSelectedPagesCommand}"
                                                          Foreground="{DynamicResource CriticalBrush}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource IconDelete}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource CriticalBrush}" StrokeThickness="1.4" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Split here"
                                                          Command="{Binding #PageThumbnailStrip.((vm:MainViewModel)DataContext).SplitDocumentAtCurrentPageCommand}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Bottom"
                                                       Text="{Binding PageNumber}"
                                                       FontSize="9.5"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,3"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Background="{DynamicResource Surface3Brush}"
                        BorderBrush="{DynamicResource BorderBrush1}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="8,0,12,10"
                        ClipToBounds="True">
                    <Grid>
                        <controls:PagePreview x:Name="PreviewImage"
                                              PageImage="{Binding PageImage}"
                                              Highlights="{Binding IndexHighlights}"
                                              OcrWords="{Binding CurrentPageWords}"
                                              ShowOcrWords="{Binding ShowOcrWords}"
                                              AllowDraw="{Binding IsAddingManualRedaction}"
                                              ZoneDrawnCommand="{Binding AddManualRedactionCommand}"
                                              ZoneChangedCommand="{Binding ChangeManualRedactionCommand}"
                                              HighlightClickedCommand="{Binding SelectIndexHighlightCommand}"
                                              Margin="8"
                                              IsVisible="{Binding PageImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding PreviewMessage}"
                                   IsVisible="{Binding PageImage, Converter={x:Static ObjectConverters.IsNull}}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="24"
                                   TextAlignment="Center" />
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush1}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="3"
                                IsVisible="{Binding PageImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <CheckBox Content="OCR text"
                                          IsChecked="{Binding ShowOcrWords}"
                                          VerticalAlignment="Center"
                                          Margin="6,0,4,0"
                                          FontSize="11.5"
                                          ToolTip.Tip="Show boxes around recognized text, with the text and confidence on hover" />
                                <Button Classes="ghost"
                                        Width="26" Height="26" Padding="0" CornerRadius="6"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="Zoom out"
                                        Click="OnZoomOutClick">
                                    <TextBlock Text="−" FontSize="15" FontWeight="Medium" />
                                </Button>
                                <TextBlock Text="{Binding #PreviewImage.Zoom, StringFormat={}{0:P0}}"
                                           VerticalAlignment="Center"
                                           Width="44"
                                           TextAlignment="Center"
                                           Classes="mono"
                                           FontSize="11.5" />
                                <Button Classes="ghost"
                                        Width="26" Height="26" Padding="0" CornerRadius="6"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="Zoom in"
                                        Click="OnZoomInClick">
                                    <TextBlock Text="+" FontSize="15" FontWeight="Medium" />
                                </Button>
                                <Button Classes="ghost"
                                        Width="26" Height="26" Padding="0" CornerRadius="6"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="Fit to window"
                                        Click="OnZoomResetClick">
                                    <TextBlock Text="⤢" FontSize="12.5" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding SelectedDocument.FileName}"
                           Margin="12,0,16,10"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12.5"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Background="{DynamicResource SurfaceBrush}"
                        IsVisible="{Binding HasMultipleSelectedDocuments}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Margin="24">
                        <TextBlock Text="Preview unavailable"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Select one document to preview its pages"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          DragIncrement="1"
                          Background="Transparent"
                          Cursor="SizeWestEast"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
            <Border Grid.Column="3"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource BorderBrush1}"
                    IsHitTestVisible="False" />

            <!-- Indexes -->
            <Grid Grid.Column="4" RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0"
                           Text="Indexes"
                           Classes="eyebrow"
                           Margin="16,14,16,8" />
                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="16,0">
                        <DockPanel Margin="0,0,0,10"
                                   IsVisible="{Binding HasReviewBatchIndexes}"
                                   LastChildFill="True">
                            <TextBlock Text="BATCH"
                                       DockPanel.Dock="Left"
                                       Classes="eyebrow"
                                       FontSize="11"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Height="1" Background="{DynamicResource BorderBrush1}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ReviewBatchIndexes}"
                                      ItemTemplate="{StaticResource IndexFieldTemplate}" />
                        <DockPanel Margin="0,8,0,10"
                                   IsVisible="{Binding HasReviewDocumentIndexes}"
                                   LastChildFill="True">
                            <TextBlock Text="DOCUMENT"
                                       DockPanel.Dock="Left"
                                       Classes="eyebrow"
                                       FontSize="11"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Height="1" Background="{DynamicResource BorderBrush1}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ReviewDocumentIndexes}"
                                      ItemTemplate="{StaticResource IndexFieldTemplate}" />
                        <DockPanel Margin="0,8,0,10"
                                   IsVisible="{Binding HasRedactionCandidates}"
                                   LastChildFill="True">
                            <TextBlock Text="REDACTIONS"
                                       DockPanel.Dock="Left"
                                       Classes="eyebrow"
                                       FontSize="11"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Height="1" Background="{DynamicResource BorderBrush1}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding RedactionCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RedactionCandidateRow">
                                    <Button Classes="redaction-row"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding SelectCommand}"
                                            Margin="0,0,0,6"
                                            ToolTip.Tip="Click to highlight this region in the preview">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsConfirmed}"
                                                      VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="6,0">
                                                <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="12.5" />
                                                <TextBlock Text="{Binding PreviewText}"
                                                           Classes="mono"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding PreviewText, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                                                <TextBlock Text="{Binding SourceDisplay}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource FaintBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ScoreDisplay}"
                                                       Classes="mono"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="16,12" Spacing="8">
                    <Button Content="{Binding ManualRedactionButtonLabel}"
                            Command="{Binding ToggleManualRedactionModeCommand}"
                            Classes.accent="{Binding IsAddingManualRedaction}"
                            IsVisible="{Binding PageImage, Converter={x:Static ObjectConverters.IsNotNull}}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Draw a rectangle anywhere on the current page to add a redaction" />
                    <TextBlock Text="Draw on the page to add a redaction. Select a manual region to move or resize it."
                               IsVisible="{Binding IsAddingManualRedaction}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" />
                    <Button Content="Remove selected manual redaction"
                            Command="{Binding RemoveManualRedactionCommand}"
                            IsVisible="{Binding HasSelectedManualRedaction}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    <Border IsVisible="{Binding HasRedactedFile}"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush1}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Redacted PDF saved" FontWeight="Medium" FontSize="12.5" />
                            <TextBlock Text="An image-only copy with the confirmed regions burned in black — the original file is untouched. Change a checkbox below and re-apply to regenerate it."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <Button Content="Open redacted file"
                                    Command="{Binding OpenRedactedFileCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Content="{Binding ApplyRedactionsButtonLabel}"
                            Command="{Binding ApplyRedactionsCommand}"
                            IsVisible="{Binding HasRedactionCandidates}"
                            Classes="accent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    <Button Content="Mark ready"
                            Command="{Binding MarkReadyCommand}"
                            Classes="accent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Table mode -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Background="{DynamicResource GroundBrush}" IsVisible="{Binding IsTableMode}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,14,20,8">
                <TextBlock Text="All documents" Classes="eyebrow" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Classes="mono"
                           Text="Grouped by profile, A–Z"
                           Foreground="{DynamicResource FaintBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1" PointerPressed="OnGroupsAreaPointerPressed">
                <StackPanel Margin="20,0,20,20" Spacing="16">
                    <TextBlock Text="Import a PDF or image to get started"
                               IsVisible="{Binding HasNoDocuments}"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,60"
                               TextAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding DocumentGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DocumentGroupViewModel">
                                <Border Classes="card" Padding="0">
                                    <StackPanel>
                                        <DockPanel Margin="14,10" LastChildFill="False">
                                            <TextBlock Text="{Binding Title}"
                                                       DockPanel.Dock="Left"
                                                       Classes="group-title"
                                                       Classes.is-unassigned="{Binding IsUnassigned}" />
                                            <TextBlock Text="{Binding DocumentCountDisplay}"
                                                       DockPanel.Dock="Right"
                                                       Classes="mono"
                                                       Foreground="{DynamicResource FaintBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <Button Content="Select All"
                                                    DockPanel.Dock="Right"
                                                    Classes="ghost"
                                                    FontSize="11"
                                                    Padding="8,3"
                                                    Margin="0,0,8,0"
                                                    Click="OnSelectAllGroupClick" />
                                        </DockPanel>
                                        <Border Height="1" Background="{DynamicResource BorderBrush1}" />
                                        <DataGrid ItemsSource="{Binding Documents}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderThickness="0"
                                                  CanUserResizeColumns="True"
                                                  CanUserSortColumns="False"
                                                  SelectionMode="Extended"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                  Loaded="OnGroupTableLoaded"
                                                  SelectionChanged="OnGroupTableSelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="4" CanUserResize="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:DocumentRow">
                                                            <Border Background="{Binding BatchAccent, Converter={x:Static conv:BatchAccentBrushConverter.Instance}, ConverterParameter=bar}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                                                <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}" Width="70" />
                                                <DataGridTemplateColumn Header="Status" Width="112">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:DocumentRow">
                                                            <Border Classes="chip"
                                                                    Classes.chip-ready="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsReady}}"
                                                                    Classes.chip-review="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsReview}}"
                                                                    Classes.chip-error="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsError}}"
                                                                    Classes.chip-neutral="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsNeutral}}"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusDisplay}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Issues" Width="150">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:DocumentRow">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding IssueDisplay, Converter={x:Static conv:StringOrDashConverter.Instance}}"
                                                                           Classes="issue-cell"
                                                                           Classes.critical="{Binding IssueDisplay, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="Duplicate"
                                                                           Classes="mono"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           IsVisible="{Binding IsDuplicate}"
                                                                           ToolTip.Tip="{Binding DuplicateTooltip}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Padding="16,8"
                Background="{DynamicResource Surface2Brush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush1}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{DynamicResource InkSoftBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Classes="mono"
                           Text="{Binding WatchStatus}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource FaintBrush}"
                           FontSize="11.5"
                           Margin="16,0"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="2"
                             Width="140"
                             Height="4"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>
    </Grid>
</Window>
