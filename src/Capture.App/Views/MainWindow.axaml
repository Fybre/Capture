<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Capture.App.ViewModels"
        xmlns:controls="using:Capture.App.Controls"
        xmlns:conv="using:Capture.App.Converters"
        xmlns:profiles="using:Capture.Core.Profiles"
        xmlns:batches="using:Capture.Core.Batches"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Capture.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Capture"
        Width="1280"
        Height="800"
        MinWidth="720"
        MinHeight="600">
    <Window.Resources>
        <!-- Icon glyphs live in Styles/Theme.axaml and resolve globally via StaticResource. -->

        <DataTemplate x:Key="IndexFieldTemplate" x:DataType="vm:IndexValueRow">
            <Border Padding="0,0,0,14">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Flag}"
                                   Foreground="{DynamicResource WarnBrush}"
                                   IsVisible="{Binding HasFlag}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Grid>
                    <TextBox Text="{Binding Text}"
                             Classes.invalid="{Binding HasFormatError}" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1,0,0">
                        <ProgressBar Value="{Binding ConfidenceValue}"
                                     Maximum="100"
                                     Height="3"
                                     Classes.low="{Binding HasFlag}"
                                     VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Classes="mono confidence-value"
                                   Classes.low="{Binding HasFlag}"
                                   Text="{Binding ConfidenceDisplay}"
                                   FontSize="10.5"
                                   Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <Border Grid.Row="0"
                Padding="16,10"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush1}">
            <StackPanel Spacing="8">

                <!-- Row 1: view mode, one-shot actions -->
                <StackPanel Orientation="Horizontal">

                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="0,2,16,2">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentBrush1}">
                            <TextBlock Text="C"
                                       Foreground="{DynamicResource AccentInkBrush}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Capture" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource BorderBrush1}" Margin="0,6,16,6" />

                    <Border Classes="segment" VerticalAlignment="Center" Margin="0,2,16,2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="segment" Classes.accent="{Binding IsPreviewMode}" Command="{Binding ShowPreviewModeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource IconPreviewMode}" Stretch="Uniform" Width="13" Height="13" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                                    <TextBlock Text="Preview" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                            <Button Classes="segment" Classes.accent="{Binding IsTableMode}" Command="{Binding ShowTableModeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="{StaticResource IconTableMode}" Stretch="Uniform" Width="13" Height="13" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                                    <TextBlock Text="Table" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Width="1" Background="{DynamicResource BorderBrush1}" Margin="0,6,16,6" />

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,16,2">
                        <Button Command="{Binding ScanCommand}"
                                Classes="soon"
                                ToolTip.Tip="Scanner support comes later">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconScan}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportFilesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconImportFile}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Import files" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconImportFolder}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Import folder" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource BorderBrush1}" Margin="0,6,16,6" />

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,0,2">
                        <Button Command="{Binding ExportCommand}"
                                Classes="soon"
                                ToolTip.Tip="Export adapters come later">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconExport}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Export" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Row 2: active batch/profile selection -->
                <DockPanel LastChildFill="False">

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" DockPanel.Dock="Right">
                        <Button Content="More ▾"
                                Classes="ghost"
                                FontSize="12.5"
                                Padding="9,5">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="2" MinWidth="180">
                                        <Button Command="{Binding OpenProfilesCommand}"
                                                Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Data="{StaticResource IconProfiles}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                                <TextBlock Text="Profiles…" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding OpenBatchProfilesCommand}"
                                                Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Data="{StaticResource IconProfiles}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                                <TextBlock Text="Batch profiles…" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding OpenSettingsCommand}"
                                                Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Data="{StaticResource IconSettings}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                                <TextBlock Text="Settings…" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,16,2" DockPanel.Dock="Left">
                        <TextBlock Text="Batch" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                        <ComboBox MinWidth="130"
                                  MaxWidth="170"
                                  Width="170"
                                  ItemsSource="{Binding BatchProfiles}"
                                  SelectedItem="{Binding SelectedBatchProfile}"
                                  PlaceholderText="None"
                                  ToolTip.Tip="Batch profile applied to manually imported files — controls when a new batch starts.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="batches:BatchProfile">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource BorderBrush1}" Margin="0,6,16,6" DockPanel.Dock="Left" />

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,16,2" DockPanel.Dock="Left">
                        <TextBlock Text="Profile" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                        <ComboBox MinWidth="140"
                                  MaxWidth="190"
                                  Width="190"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedImportProfile}"
                                  PlaceholderText="None">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="profiles:IndexingProfile">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Command="{Binding ApplySelectedProfileCommand}"
                                CommandParameter="{Binding SelectedImportProfile}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconApply}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Apply profile" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource BorderBrush1}" Margin="0,6,16,6" DockPanel.Dock="Left" />

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,2,16,2" DockPanel.Dock="Left">
                        <Button Command="{Binding RemoveSelectedCommand}"
                                Classes="ghost"
                                Foreground="{DynamicResource CriticalBrush}"
                                ToolTip.Tip="Remove the selected document(s) (Delete)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource IconRemove}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                <TextBlock Text="Remove" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding SelectedDocumentsSummary}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12"
                                   IsVisible="{Binding HasSelectedDocuments}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300,1,*,1,292" Background="{DynamicResource GroundBrush}" IsVisible="{Binding IsPreviewMode}">
            <!-- Inbox -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,16,8">
                    <TextBlock Text="Inbox" Classes="eyebrow" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Classes="mono"
                               Text="{Binding Documents.Count, StringFormat='{}{0} documents'}"
                               Foreground="{DynamicResource FaintBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" Margin="8,0">
                    <DataGrid x:Name="InboxGrid"
                              ItemsSource="{Binding Documents}"
                              SelectedItem="{Binding SelectedDocument}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="None"
                              HeadersVisibility="None"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="True"
                              BorderThickness="0"
                              RowHeight="46"
                              DragDrop.AllowDrop="True">
                        <DataGrid.KeyBindings>
                            <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedCommand}" />
                            <KeyBinding Gesture="Back" Command="{Binding RemoveSelectedCommand}" />
                        </DataGrid.KeyBindings>
                        <DataGrid.Styles>
                            <Style Selector="DataGridRow" x:DataType="vm:DocumentRow">
                                <Setter Property="(DragDrop.AllowDrop)" Value="True" />
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="4" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DocumentRow">
                                        <Border CornerRadius="2"
                                                Margin="0,3"
                                                Background="{Binding BatchAccent, Converter={x:Static conv:BatchAccentBrushConverter.Instance}, ConverterParameter=bar}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" CanUserSort="True" SortMemberPath="FileName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DocumentRow">
                                        <StackPanel Spacing="4" Margin="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Classes="chip"
                                                        Classes.chip-ready="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsReady}}"
                                                        Classes.chip-review="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsReview}}"
                                                        Classes.chip-error="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsError}}"
                                                        Classes.chip-neutral="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsNeutral}}">
                                                    <TextBlock Text="{Binding StatusDisplay}" />
                                                </Border>
                                                <TextBlock Text="{Binding IssueDisplay}"
                                                           Classes="mono"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource CriticalBrush}"
                                                           IsVisible="{Binding IssueDisplay, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Import a PDF or image to get started"
                               IsVisible="{Binding HasNoDocuments}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="24"
                               TextAlignment="Center" />
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource BorderBrush1}" />

            <!-- Preview -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Background="{DynamicResource SurfaceBrush}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,10">
                    <Button Classes="ghost"
                            Command="{Binding PreviousPageCommand}"
                            Width="30" Height="30" Padding="0" CornerRadius="7"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform" Width="14" Height="14" Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Classes="mono"
                               Text="{Binding PageLabel}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="Medium" />
                    <Button Grid.Column="2"
                            Classes="ghost"
                            Command="{Binding NextPageCommand}"
                            Width="30" Height="30" Padding="0" CornerRadius="7"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform" Width="14" Height="14" Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6" />
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource Surface3Brush}"
                        BorderBrush="{DynamicResource BorderBrush1}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12,0,12,10"
                        ClipToBounds="True">
                    <Grid>
                        <controls:PagePreview x:Name="PreviewImage"
                                              PageImage="{Binding PageImage}"
                                              Highlights="{Binding IndexHighlights}"
                                              HighlightClickedCommand="{Binding SelectIndexHighlightCommand}"
                                              Margin="8"
                                              IsVisible="{Binding PageImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding PreviewMessage}"
                                   IsVisible="{Binding PageImage, Converter={x:Static ObjectConverters.IsNull}}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="24"
                                   TextAlignment="Center" />
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush1}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="3"
                                IsVisible="{Binding PageImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="ghost"
                                        Width="26" Height="26" Padding="0" CornerRadius="6"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="Zoom out"
                                        Click="OnZoomOutClick">
                                    <TextBlock Text="−" FontSize="15" FontWeight="Medium" />
                                </Button>
                                <TextBlock Text="{Binding #PreviewImage.Zoom, StringFormat={}{0:P0}}"
                                           VerticalAlignment="Center"
                                           Width="44"
                                           TextAlignment="Center"
                                           Classes="mono"
                                           FontSize="11.5" />
                                <Button Classes="ghost"
                                        Width="26" Height="26" Padding="0" CornerRadius="6"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="Zoom in"
                                        Click="OnZoomInClick">
                                    <TextBlock Text="+" FontSize="15" FontWeight="Medium" />
                                </Button>
                                <Button Classes="ghost"
                                        Width="26" Height="26" Padding="0" CornerRadius="6"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="Fit to window"
                                        Click="OnZoomResetClick">
                                    <TextBlock Text="⤢" FontSize="12.5" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="{Binding SelectedDocument.FileName}"
                           Margin="16,0,16,10"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12.5"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Border Grid.Column="3" Background="{DynamicResource BorderBrush1}" />

            <!-- Indexes -->
            <Grid Grid.Column="4" RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0"
                           Text="Indexes"
                           Classes="eyebrow"
                           Margin="16,14,16,8" />
                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="16,0">
                        <DockPanel Margin="0,0,0,10"
                                   IsVisible="{Binding HasReviewBatchIndexes}"
                                   LastChildFill="True">
                            <TextBlock Text="BATCH"
                                       DockPanel.Dock="Left"
                                       Classes="eyebrow"
                                       FontSize="11"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Height="1" Background="{DynamicResource BorderBrush1}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ReviewBatchIndexes}"
                                      ItemTemplate="{StaticResource IndexFieldTemplate}" />
                        <DockPanel Margin="0,8,0,10"
                                   IsVisible="{Binding HasReviewDocumentIndexes}"
                                   LastChildFill="True">
                            <TextBlock Text="DOCUMENT"
                                       DockPanel.Dock="Left"
                                       Classes="eyebrow"
                                       FontSize="11"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Height="1" Background="{DynamicResource BorderBrush1}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ReviewDocumentIndexes}"
                                      ItemTemplate="{StaticResource IndexFieldTemplate}" />
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="2"
                        Content="Mark ready"
                        Command="{Binding MarkReadyCommand}"
                        Classes="accent"
                        Margin="16,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
            </Grid>
        </Grid>

        <!-- Table mode -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Background="{DynamicResource GroundBrush}" IsVisible="{Binding IsTableMode}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,14,20,8">
                <TextBlock Text="All documents" Classes="eyebrow" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Classes="mono"
                           Text="Grouped by profile, A–Z"
                           Foreground="{DynamicResource FaintBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="20,0,20,20" Spacing="16">
                    <TextBlock Text="Import a PDF or image to get started"
                               IsVisible="{Binding HasNoDocuments}"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,60"
                               TextAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding DocumentGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DocumentGroupViewModel">
                                <Border Classes="card" Padding="0">
                                    <StackPanel>
                                        <DockPanel Margin="14,10" LastChildFill="False">
                                            <TextBlock Text="{Binding Title}"
                                                       DockPanel.Dock="Left"
                                                       Classes="group-title"
                                                       Classes.is-unassigned="{Binding IsUnassigned}" />
                                            <TextBlock Text="{Binding DocumentCountDisplay}"
                                                       DockPanel.Dock="Right"
                                                       Classes="mono"
                                                       Foreground="{DynamicResource FaintBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Border Height="1" Background="{DynamicResource BorderBrush1}" />
                                        <DataGrid ItemsSource="{Binding Documents}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderThickness="0"
                                                  CanUserResizeColumns="True"
                                                  CanUserSortColumns="False"
                                                  SelectionMode="Extended"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                  Loaded="OnGroupTableLoaded"
                                                  SelectionChanged="OnGroupTableSelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="4" CanUserResize="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:DocumentRow">
                                                            <Border Background="{Binding BatchAccent, Converter={x:Static conv:BatchAccentBrushConverter.Instance}, ConverterParameter=bar}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                                                <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}" Width="70" />
                                                <DataGridTemplateColumn Header="Status" Width="112">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:DocumentRow">
                                                            <Border Classes="chip"
                                                                    Classes.chip-ready="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsReady}}"
                                                                    Classes.chip-review="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsReview}}"
                                                                    Classes.chip-error="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsError}}"
                                                                    Classes.chip-neutral="{Binding StatusDisplay, Converter={x:Static conv:StatusChipConverter.IsNeutral}}"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusDisplay}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Issues" Width="150">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:DocumentRow">
                                                            <TextBlock Text="{Binding IssueDisplay, Converter={x:Static conv:StringOrDashConverter.Instance}}"
                                                                       Classes="issue-cell"
                                                                       Classes.critical="{Binding IssueDisplay, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                                                       VerticalAlignment="Center" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Padding="16,8"
                Background="{DynamicResource Surface2Brush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush1}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{DynamicResource InkSoftBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Classes="mono"
                           Text="{Binding WatchStatus}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource FaintBrush}"
                           FontSize="11.5"
                           Margin="16,0"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="2"
                             Width="140"
                             Height="4"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>
    </Grid>
</Window>
