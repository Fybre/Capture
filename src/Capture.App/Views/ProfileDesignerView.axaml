<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Capture.App.ViewModels"
              xmlns:controls="using:Capture.App.Controls"
              xmlns:indexing="using:Capture.Core.Indexing"
              xmlns:redaction="using:Capture.Core.Redaction"
             x:Class="Capture.App.Views.ProfileDesignerView"
             x:DataType="vm:ProfileDesignerViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource GroundBrush}">
        <Border Grid.Row="0"
                Padding="16,10"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush1}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Command="{Binding CloseCommand}" Classes="ghost">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform" Width="12" Height="12" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>
                <TextBox Grid.Column="1"
                         Text="{Binding Name}"
                         Watermark="Profile name"
                         Margin="12,0"
                         VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Command="{Binding SaveCommand}"
                        Classes="accent"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="{StaticResource IconSave}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="*,5,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="560" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="300" MinWidth="220" MaxWidth="560" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0"
                          Grid.RowSpan="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12" Spacing="8">
                        <TextBlock Text="Add field"
                                   Classes="eyebrow"
                                   Margin="4,2,4,4" />
                        <Button Content="Text"
                                Command="{Binding AddTextCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Lookup"
                                Command="{Binding AddLookupCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Zone"
                                Command="{Binding AddZoneCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Barcode"
                                Command="{Binding AddBarcodeCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Key/value"
                                Command="{Binding AddKeyValueCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Regex"
                                Command="{Binding AddRegexCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="AI"
                                Command="{Binding AddAiCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Script"
                                Command="{Binding AddScriptFieldCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Content="Button"
                                Command="{Binding AddButtonFieldCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Command="{Binding AddBatchSeparatorValueCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <TextBlock Text="Batch separator value"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </Button>
                    <Border Height="1" Background="{DynamicResource BorderBrush1}" Margin="0,4" />
                    <TextBlock Text="Profile settings" Classes="eyebrow" Margin="4,2,4,4" />
                    <TextBlock Text="Sample" Classes="field-label" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding SampleFileName, TargetNullValue='No sample — blank profile'}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Classes="mono"
                                   FontSize="12" />
                        <Button Grid.Column="1"
                                Content="Change…"
                                Command="{Binding ChangeSampleCommand}"
                                Classes="ghost"
                                FontSize="12"
                                Padding="8,3"
                                Margin="6,0,0,0" />
                    </Grid>
                    <TextBlock Text="Loading a different sample replaces every page image/preview for this profile — zones you've drawn will need to be re-checked against the new pages."
                               TextWrapping="Wrap"
                               Classes="hint" />

                    <Border Height="1" Background="{DynamicResource BorderBrush1}" Margin="0,4" />
                    <TextBlock Text="Page separation" Classes="field-label" />
                    <ComboBox ItemsSource="{Binding SeparationTriggerOptions}"
                              SelectedItem="{Binding SeparationTrigger}"
                              HorizontalAlignment="Stretch" />

                    <StackPanel Spacing="6" IsVisible="{Binding IsSeparationBarcode}">
                        <TextBlock Text="Barcode field" Classes="field-label" />
                        <ComboBox ItemsSource="{Binding BarcodeFieldOptions}"
                                  SelectedItem="{Binding SeparationBarcodeField}"
                                  PlaceholderText="Choose a barcode field"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FieldRow">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Add a barcode field first, then pick it here."
                                   TextWrapping="Wrap"
                                   Classes="hint"
                                   IsVisible="{Binding !HasBarcodeFieldOptions}" />
                        <CheckBox Content="Remove separator page" IsChecked="{Binding SeparationDiscardPage}" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding IsSeparationBlank}">
                        <CheckBox Content="Remove separator page" IsChecked="{Binding SeparationDiscardPage}" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding IsSeparationEveryNPages}">
                        <TextBlock Text="Pages per document" Classes="field-label" />
                        <NumericUpDown Value="{Binding SeparationPageCount}" Minimum="1" Maximum="500" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush1}" Margin="0,4" />
                    <CheckBox Content="Redaction" IsChecked="{Binding RedactionEnabled}" />
                    <StackPanel Spacing="6" IsVisible="{Binding RedactionEnabled}">
                        <CheckBox Content="Detect PII automatically (Presidio)" IsChecked="{Binding RedactionDetectPii}" />
                        <TextBlock Text="Fields marked Sensitive are always redacted, regardless of this setting — turn this off to redact only Sensitive fields, with no PII detection."
                                   TextWrapping="Wrap"
                                   Classes="hint" />
                        <StackPanel Spacing="6" IsVisible="{Binding RedactionDetectPii}">
                            <TextBlock Text="Redaction set" Classes="field-label" />
                            <ComboBox ItemsSource="{Binding RedactionSetOptions}"
                                      SelectedItem="{Binding SelectedRedactionSet}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="redaction:RedactionEntitySet">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Which PII types this set detects. Manage sets from Settings."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                            <TextBlock Text="Minimum confidence" Classes="field-label" />
                            <NumericUpDown Value="{Binding RedactionScoreThreshold}" Minimum="0" Maximum="100" />
                            <TextBlock Text="Matches below this confidence are ignored entirely."
                                       TextWrapping="Wrap"
                                       Classes="hint" />
                        </StackPanel>
                        <TextBlock Text="Skip review at/above" Classes="field-label" />
                        <NumericUpDown Value="{Binding RedactionBypassScoreThreshold}" Minimum="0" Maximum="100" />
                        <TextBlock Text="Matches at or above this confidence are redacted automatically, no manual review. 0 always skips review; 100 (default) only skips it for fields explicitly marked Sensitive."
                                   TextWrapping="Wrap"
                                   Classes="hint" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush1}" Margin="0,4" />
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Exports" Classes="field-label" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <Button Content="+ Add" Command="{Binding AddExportDefinitionCommand}" Classes="ghost" DockPanel.Dock="Right" FontSize="12" Padding="8,3" />
                    </DockPanel>
                    <TextBlock Text="Each document's Export button runs every enabled export below. Click a row's arrow to show its settings."
                               TextWrapping="Wrap"
                               Classes="hint" />
                    <ItemsControl ItemsSource="{Binding Exports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExportDefinitionRow">
                                <Border Classes="card" Padding="0" Margin="0,4">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="8,6">
                                            <Button Grid.Column="0"
                                                    Classes="ghost"
                                                    Width="26" Height="26" Padding="0" CornerRadius="6"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    ToolTip.Tip="Show/hide this export's settings"
                                                    Command="{Binding $parent[UserControl].((vm:ProfileDesignerViewModel)DataContext).ToggleExportExpandedCommand}"
                                                    CommandParameter="{Binding}">
                                                <Panel>
                                                    <TextBlock Text="▾" FontSize="11" IsVisible="{Binding IsExpanded}" />
                                                    <TextBlock Text="▸" FontSize="11" IsVisible="{Binding !IsExpanded}" />
                                                </Panel>
                                            </Button>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" Margin="4,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Enabled" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                        </Grid>

                                        <StackPanel Spacing="6" Margin="12,0,12,12" IsVisible="{Binding IsExpanded}">
                                            <TextBlock Text="Name" Classes="field-label" />
                                            <TextBox Text="{Binding Name}" Watermark="Export name" />

                                            <TextBlock Text="Type" Classes="field-label" />
                                            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch" />

                                            <StackPanel Spacing="6" IsVisible="{Binding IsCsv}">
                                                <TextBlock Text="Output folder" Classes="field-label" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Text="{Binding OutputFolder}" Watermark="Choose a folder…" IsReadOnly="True" />
                                                    <Button Grid.Column="1"
                                                            Content="Browse…"
                                                            Command="{Binding $parent[UserControl].((vm:ProfileDesignerViewModel)DataContext).BrowseExportFolderCommand}"
                                                            CommandParameter="{Binding}"
                                                            Margin="6,0,0,0" />
                                                </Grid>

                                                <TextBlock Text="Output mode" Classes="field-label" />
                                                <ComboBox ItemsSource="{Binding OutputModeOptions}" SelectedItem="{Binding OutputMode}" HorizontalAlignment="Stretch" />

                                                <StackPanel Spacing="6" IsVisible="{Binding IsAppendMode}">
                                                    <TextBlock Text="Shared file name" Classes="field-label" />
                                                    <TextBox Text="{Binding SharedFileName}" Watermark="export.csv" />
                                                    <TextBlock Text="Every document appends a row to this one file." TextWrapping="Wrap" Classes="hint" />
                                                </StackPanel>

                                                <StackPanel Spacing="6" IsVisible="{Binding !IsAppendMode}">
                                                    <TextBlock Text="File name pattern" Classes="field-label" />
                                                    <TextBox Text="{Binding FileNamePattern}" Watermark="{}{OriginalFileName}" />
                                                    <Expander IsExpanded="False"
                                                              MinHeight="24"
                                                              Padding="0"
                                                              BorderThickness="0"
                                                              Background="Transparent"
                                                              HorizontalAlignment="Stretch">
                                                        <Expander.Resources>
                                                            <x:Double x:Key="ExpanderChevronButtonSize">20</x:Double>
                                                            <Thickness x:Key="ExpanderHeaderPadding">2,0,0,0</Thickness>
                                                            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                                            <Thickness x:Key="ExpanderChevronMargin">4,0,2,0</Thickness>
                                                            <Thickness x:Key="ExpanderContentPadding">0</Thickness>
                                                            <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                                                            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
                                                            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
                                                        </Expander.Resources>
                                                        <Expander.Header>
                                                            <TextBlock Text="File name syntax"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource MutedBrush}" />
                                                        </Expander.Header>
                                                        <TextBlock Text="Each document gets its own file. Use {OriginalFileName}, {DocumentId}, {Date}, {Time}, or any profile field name such as {InvoiceNo}. Add a .NET format after |, for example {Date|yyyy-MM-dd} or {Time|HH-mm-ss}. Invalid filename characters are replaced with _, trailing periods/spaces are removed, and an empty result falls back to the document ID."
                                                                   TextWrapping="Wrap"
                                                                   Classes="hint"
                                                                   Margin="2,4,2,2" />
                                                    </Expander>
                                                </StackPanel>

                                                <CheckBox Content="Include header row" IsChecked="{Binding IncludeHeader}" />

                                                <TextBlock Text="Fields to include" Classes="field-label" />
                                                <TextBlock Text="All fields are included when none are checked."
                                                           TextWrapping="Wrap"
                                                           Classes="hint" />
                                                <ItemsControl ItemsSource="{Binding FieldOptions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:FieldSelectionRow">
                                                            <CheckBox Content="{Binding Field.Name}" IsChecked="{Binding IsSelected}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Spacing="6" IsVisible="{Binding IsTherefore}">
                                                <TextBlock Text="Category" Classes="field-label" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding ThereforeCategoryDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1"
                                                            Content="Browse…"
                                                            Command="{Binding $parent[UserControl].((vm:ProfileDesignerViewModel)DataContext).BrowseThereforeCategoryCommand}"
                                                            CommandParameter="{Binding}"
                                                            Margin="6,0,0,0" />
                                                </Grid>

                                                <TextBlock Text="Field mapping" Classes="field-label" Margin="0,4,0,0" />
                                                <TextBlock Text="Choose a profile field for each Therefore field, or leave it unmapped."
                                                           TextWrapping="Wrap"
                                                           Classes="hint" />
                                                <ItemsControl ItemsSource="{Binding ThereforeMappings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ThereforeFieldMappingRow">
                                                            <Grid ColumnDefinitions="*,*" Margin="0,3">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="•"
                                                                               Foreground="{DynamicResource WarnBrush}"
                                                                               ToolTip.Tip="Mandatory in Therefore"
                                                                               IsVisible="{Binding Mandatory}" />
                                                                </StackPanel>
                                                                <ComboBox Grid.Column="1"
                                                                          ItemsSource="{Binding ProfileFields}"
                                                                          SelectedItem="{Binding SelectedField}"
                                                                          PlaceholderText="— none —"
                                                                          HorizontalAlignment="Stretch">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:FieldRow">
                                                                            <TextBlock Text="{Binding Name}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <TextBlock Text="Attach file" Classes="field-label" Margin="0,4,0,0" />
                                            <ComboBox ItemsSource="{Binding FileModeOptions}" SelectedItem="{Binding FileMode}" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="Redacted falls back to the original if the document hasn't been redacted yet."
                                                       TextWrapping="Wrap"
                                                       Classes="hint"
                                                       IsVisible="{Binding HasFileMode}" />

                                            <Button Content="Remove this export"
                                                    Command="{Binding $parent[UserControl].((vm:ProfileDesignerViewModel)DataContext).RemoveExportDefinitionCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Margin="0,6,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No exports configured yet."
                               IsVisible="{Binding HasNoExports}"
                               Classes="hint" />

                    <CheckBox Content="Remove from inbox after export" IsChecked="{Binding RemoveAfterExport}" />
                    <TextBlock Text="Once every enabled export succeeds, the document is deleted instead of being marked Exported."
                               TextWrapping="Wrap"
                               Classes="hint" />

                    <Border Height="1" Background="{DynamicResource BorderBrush1}" Margin="0,4" />
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Shared functions" Classes="field-label" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <Button Content="Pop out"
                                Command="{Binding PopOutSharedScriptCommand}"
                                Classes="ghost"
                                DockPanel.Dock="Right"
                                FontSize="12"
                                Padding="8,3" />
                    </DockPanel>
                    <TextBlock Text="C# available to every script on this profile — profile-level scripts, Script field expressions, and Button field scripts — so a helper written here doesn't need to be copy-pasted into each one. Declare functions only; this text isn't run on its own."
                               TextWrapping="Wrap"
                               Classes="hint" />
                    <TextBox Text="{Binding SharedScriptSource}"
                              Watermark="static string Clean(string s) =&gt; s.Trim().ToUpperInvariant();"
                              AcceptsReturn="True"
                              TextWrapping="NoWrap"
                              Classes="mono"
                              Height="90" />

                    <Border Height="1" Background="{DynamicResource BorderBrush1}" Margin="0,4" />
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Scripts" Classes="field-label" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <Button Content="+ Add" Command="{Binding AddScriptCommand}" Classes="ghost" DockPanel.Dock="Right" FontSize="12" Padding="8,3" />
                        <Button Content="Scripting help" Command="{Binding ShowScriptingHelpCommand}" Classes="ghost" DockPanel.Dock="Right" FontSize="12" Padding="8,3" Margin="0,0,6,0" />
                    </DockPanel>
                    <TextBlock Text="C# that runs after this profile's fields are extracted, with full read/write access to every field — for cross-field logic a Text/Lookup default or a Script field's own expression can't do, including REST calls. Document exposes the current document: FileName, FileExtension, PageCount, and Text (its full extracted OCR/PDF text)."
                               TextWrapping="Wrap"
                               Classes="hint" />
                    <TextBlock Text="Off by default in Settings — a script runs with full access to this computer. &quot;Run test&quot; below always works regardless, since it's a single-document action you take yourself."
                               TextWrapping="Wrap"
                               Classes="hint"
                               IsVisible="{Binding !IsScriptingAvailable}" />
                    <ItemsControl ItemsSource="{Binding Scripts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScriptRow">
                                <Border Classes="card" Padding="10" Margin="0,4">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Enabled" />
                                            <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="Script name" />
                                        </Grid>
                                        <TextBlock Text="Runs" Classes="field-label" Margin="0,4,0,0" />
                                        <ComboBox ItemsSource="{Binding TriggerOptions}" SelectedItem="{Binding Trigger}" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="Timeout (seconds)" Classes="field-label" Margin="0,4,0,0" />
                                        <NumericUpDown Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="120" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Source" Classes="field-label" Margin="0,4,0,0" VerticalAlignment="Bottom" />
                                            <Button Grid.Column="1"
                                                    Content="Pop out"
                                                    Command="{Binding $parent[UserControl].((vm:ProfileDesignerViewModel)DataContext).PopOutScriptCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="ghost"
                                                    FontSize="12"
                                                    Padding="8,3" />
                                        </Grid>
                                        <TextBox Text="{Binding Source}"
                                                  Watermark="Fields[&quot;Total&quot;].Value = &quot;42&quot;;"
                                                  AcceptsReturn="True"
                                                  TextWrapping="NoWrap"
                                                  Classes="mono"
                                                  Height="90" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0"
                                                    Content="Run test"
                                                    Command="{Binding $parent[UserControl].((vm:ProfileDesignerViewModel)DataContext).RunScriptTestCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="Remove"
                                                    Command="{Binding $parent[UserControl].((vm:ProfileDesignerViewModel)DataContext).RemoveScriptCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="6,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No scripts configured yet."
                               IsVisible="{Binding HasNoScripts}"
                               Classes="hint" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          Grid.RowSpan="3"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          DragIncrement="1"
                          Background="Transparent"
                          Cursor="SizeWestEast"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
            <Border Grid.Column="1"
                    Grid.RowSpan="3"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource BorderBrush1}"
                    IsHitTestVisible="False" />

            <Grid Grid.Column="2"
                  Grid.RowSpan="3"
                  RowDefinitions="Auto,*"
                  Background="{DynamicResource SurfaceBrush}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,10">
                    <Button Classes="ghost nav" Command="{Binding PreviousPageCommand}">
                        <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform" Width="14" Height="14" Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Classes="mono"
                               Text="{Binding PageLabel}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="Medium" />
                    <Button Grid.Column="2" Classes="ghost nav" Command="{Binding NextPageCommand}">
                        <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform" Width="14" Height="14" Stroke="{DynamicResource InkSoftBrush}" StrokeThickness="1.6" />
                    </Button>
                </Grid>
                <Border Grid.Row="1"
                        Background="{DynamicResource Surface3Brush}"
                        BorderBrush="{DynamicResource BorderBrush1}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12,0,12,10"
                        ClipToBounds="True">
                    <Grid>
                        <controls:PagePreview x:Name="PreviewImage"
                                              PageImage="{Binding PageImage}"
                                              Highlights="{Binding Highlights}"
                                              OcrWords="{Binding CurrentPageWords}"
                                              ShowOcrWords="{Binding ShowOcrWords}"
                                              AllowDraw="True"
                                              ZoneDrawnCommand="{Binding CompleteZoneCommand}"
                                              ZoneChangedCommand="{Binding ChangeZoneCommand}"
                                              HighlightClickedCommand="{Binding SelectHighlightCommand}"
                                              Margin="8" />
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush1}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="3"
                                IsVisible="{Binding PageImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <CheckBox Content="OCR text"
                                          IsChecked="{Binding ShowOcrWords}"
                                          VerticalAlignment="Center"
                                          Margin="6,0,4,0"
                                          FontSize="11.5"
                                          ToolTip.Tip="Show boxes around recognized text, to see why a zone or pattern draw did or didn't match" />
                                <Button Classes="ghost"
                                        Width="26" Height="26" Padding="0" CornerRadius="6"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="Zoom out"
                                        Click="OnZoomOutClick">
                                    <TextBlock Text="−" FontSize="15" FontWeight="Medium" />
                                </Button>
                                <TextBlock Text="{Binding #PreviewImage.Zoom, StringFormat={}{0:P0}}"
                                           VerticalAlignment="Center"
                                           Width="44"
                                           TextAlignment="Center"
                                           Classes="mono"
                                           FontSize="11.5" />
                                <Button Classes="ghost"
                                        Width="26" Height="26" Padding="0" CornerRadius="6"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="Zoom in"
                                        Click="OnZoomInClick">
                                    <TextBlock Text="+" FontSize="15" FontWeight="Medium" />
                                </Button>
                                <Button Classes="ghost"
                                        Width="26" Height="26" Padding="0" CornerRadius="6"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip.Tip="Fit to window"
                                        Click="OnZoomResetClick">
                                    <TextBlock Text="⤢" FontSize="12.5" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Grid.RowSpan="3"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          DragIncrement="1"
                          Background="Transparent"
                          Cursor="SizeWestEast"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
            <Border Grid.Column="3"
                    Grid.RowSpan="3"
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource BorderBrush1}"
                    IsHitTestVisible="False" />

            <Grid Grid.Row="0" Grid.Column="4" RowDefinitions="Auto,*">
                <TextBlock Text="Fields"
                           Classes="eyebrow"
                           Margin="16,14,16,8" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Fields}"
                         SelectedItem="{Binding SelectedField}"
                         BorderThickness="0"
                         Margin="8,0,8,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldRow">
                            <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding PageDisplay}" Classes="field-label" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Vertical"
                                            Spacing="1"
                                            VerticalAlignment="Center"
                                            Margin="6,0,0,0"
                                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}">
                                    <Button Content="&#x25B2;"
                                            Command="{Binding $parent[UserControl].((vm:ProfileDesignerViewModel)DataContext).MoveFieldUpCommand}"
                                            Classes="ghost"
                                            Padding="4,1"
                                            FontSize="9"
                                            ToolTip.Tip="Move field up" />
                                    <Button Content="&#x25BC;"
                                            Command="{Binding $parent[UserControl].((vm:ProfileDesignerViewModel)DataContext).MoveFieldDownCommand}"
                                            Classes="ghost"
                                            Padding="4,1"
                                            FontSize="9"
                                            ToolTip.Tip="Move field down" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Row="1"
                          Grid.Column="4"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Background="{DynamicResource BorderStrongBrush}"
                          Cursor="SizeNorthSouth"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}" />

             <ScrollViewer x:Name="FieldPropertiesScroll"
                           Grid.Row="2"
                           Grid.Column="4"
                           IsVisible="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}">
             <Panel Margin="16,12">
             <StackPanel Spacing="10"
                         IsVisible="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Field properties" Classes="section-title" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Delete"
                            Command="{Binding DeleteFieldCommand}"
                            Classes="ghost"
                            Foreground="{DynamicResource CriticalBrush}"
                            Padding="8,4" />
                </Grid>
                <TextBlock Text="Name" Classes="field-label" />
                <TextBox Text="{Binding SelectedField.Name}"
                         IsEnabled="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}"
                         GotFocus="OnClearPatternGotFocus" />
                <TextBlock Text="Format" Classes="field-label" />
                <ComboBox ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedField.Format}"
                          IsEnabled="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <CheckBox Content="Mandatory"
                          IsChecked="{Binding SelectedField.Mandatory}"
                          IsEnabled="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <CheckBox Content="Sensitive"
                          IsChecked="{Binding SelectedField.Sensitive}"
                          IsEnabled="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}"
                          ToolTip.Tip="Offers this field's extracted value for redaction when the profile's Redaction setting is enabled." />
                <CheckBox Content="Hidden"
                          IsChecked="{Binding SelectedField.Hidden}"
                          IsEnabled="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}"
                          ToolTip.Tip="Excludes this field from the index grid and Ready/NeedsReview status checks." />
                <CheckBox Content="Read only"
                          IsChecked="{Binding SelectedField.IsReadOnly}"
                          IsEnabled="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}"
                          ToolTip.Tip="Can't be hand-edited in the review panel and is excluded from missing/low-confidence checks. Invalid values still require review." />
                <TextBlock Text="Level" Classes="field-label" />
                <ComboBox ItemsSource="{Binding SelectedField.Levels}"
                          SelectedItem="{Binding SelectedField.Level}"
                          IsEnabled="{Binding SelectedField, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <StackPanel Spacing="8" IsVisible="{Binding SelectedField.IsZonal}">
                    <TextBlock Text="Page" Classes="field-label" />
                    <NumericUpDown Value="{Binding SelectedFieldPageNumber}" Minimum="1" Maximum="{Binding PageCount}" />
                    <TextBlock Text="Which page of the sample this zone was drawn on — change it if the field targets a different page than the one shown."
                               TextWrapping="Wrap"
                               Classes="hint" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding SelectedField.IsAi}">
                    <TextBlock Text="Classification" Classes="field-label" />
                    <ComboBox ItemsSource="{Binding SelectedField.Classifications}"
                              SelectedItem="{Binding SelectedField.SelectedClassification}" />
                    <TextBlock Text="Field type" Classes="field-label" />
                    <ComboBox ItemsSource="{Binding SelectedField.AiTypes}"
                              SelectedItem="{Binding SelectedField.SelectedAiType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="indexing:AiFieldType">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedField.AiPromptLabel}" Classes="field-label" />
                    <TextBox Text="{Binding SelectedField.AiPrompt}"
                             Watermark="{Binding SelectedField.AiPromptWatermark}"
                             TextWrapping="Wrap" />
                    <TextBlock Text="This field has no preset meaning — the description above is the only thing telling the AI what to extract."
                               TextWrapping="Wrap"
                               Classes="hint"
                               IsVisible="{Binding SelectedField.IsCustomAiType}" />
                    <Button Content="Extract with AI"
                            Command="{Binding ExtractAiCommand}"
                            HorizontalAlignment="Stretch" />
                    <TextBlock Text="All AI fields on this profile are sent in one request."
                               TextWrapping="Wrap"
                               Classes="hint" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding SelectedField.IsBarcode}">
                    <TextBlock Text="Page" Classes="field-label" />
                    <ComboBox ItemsSource="{Binding SelectedField.PageScopes}"
                              SelectedItem="{Binding SelectedField.PageScope}" />
                    <NumericUpDown Value="{Binding SelectedFieldPageNumber}" Minimum="1" Maximum="{Binding PageCount}"
                                   IsVisible="{Binding SelectedField.IsPageNumberScope}" />
                    <TextBlock Text="Value pattern (optional)" Classes="field-label" />
                    <TextBox Text="{Binding SelectedField.ValuePattern}"
                             Watermark="Leave empty for any barcode" />
                    <TextBlock Text="Draw a zone around the barcode, or leave it unset to scan the whole page. To use this field for document splitting, set it under Page separation."
                               TextWrapping="Wrap"
                               Classes="hint" />
                </StackPanel>
                <StackPanel Spacing="10"
                            IsVisible="{Binding SelectedField.IsKeyValue}">
                    <TextBlock Text="Key pattern" Classes="field-label" Margin="0,8,0,0" />
                    <TextBox Text="{Binding SelectedField.KeyPattern}"
                             Watermark="Invoice\s*No"
                             GotFocus="OnKeyPatternGotFocus" />
                    <TextBlock Text="Value pattern" Classes="field-label" />
                    <TextBox Text="{Binding SelectedField.ValuePattern}"
                             Watermark="\S+"
                             GotFocus="OnValuePatternGotFocus" />
                </StackPanel>
                <StackPanel Spacing="10"
                            IsVisible="{Binding SelectedField.IsRegex}">
                    <TextBlock Text="Regex" Classes="field-label" Margin="0,8,0,0" />
                    <TextBox Text="{Binding SelectedField.ValuePattern}"
                             Watermark="PO[-\s]?(\d+)"
                             GotFocus="OnValuePatternGotFocus" />
                </StackPanel>
                <StackPanel Spacing="10"
                            IsVisible="{Binding SelectedField.IsPatternField}">
                    <TextBlock Text="Occurrence" Classes="field-label" />
                    <ComboBox ItemsSource="{Binding SelectedField.Occurrences}"
                              SelectedItem="{Binding SelectedField.Occurrence}" />
                    <TextBlock Text="Page" Classes="field-label" />
                    <ComboBox ItemsSource="{Binding SelectedField.PageScopes}"
                              SelectedItem="{Binding SelectedField.PageScope}" />
                    <NumericUpDown Value="{Binding SelectedFieldPageNumber}" Minimum="1" Maximum="{Binding PageCount}"
                                   IsVisible="{Binding SelectedField.IsPageNumberScope}" />
                    <TextBlock Text="Click in a pattern box, then draw on the page to suggest a regex. Draw without a pattern box focused to set a search region."
                               TextWrapping="Wrap"
                               Classes="hint" />
                    <Button Content="Clear search region"
                            Command="{Binding ClearSearchZoneCommand}"
                            IsVisible="{Binding SelectedField.HasSearchZone}" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding SelectedField.IsText}">
                    <TextBlock Text="This field is entered manually in the indexing panel. Its format controls validation; Date fields provide a calendar picker."
                               TextWrapping="Wrap"
                               Classes="hint"
                               Margin="0,8,0,0" />
                    <TextBlock Text="Default value" Classes="field-label" Margin="0,4,0,0" />
                    <TextBox Text="{Binding SelectedField.DefaultValueTemplate}"
                              Watermark="e.g. {Doc#|000}-{InvoiceNo}"
                              AcceptsReturn="False" />
                    <Expander IsExpanded="False"
                              MinHeight="24"
                              Padding="0"
                              BorderThickness="0"
                              Background="Transparent"
                              HorizontalAlignment="Stretch">
                        <Expander.Resources>
                            <x:Double x:Key="ExpanderChevronButtonSize">20</x:Double>
                            <Thickness x:Key="ExpanderHeaderPadding">2,0,0,0</Thickness>
                            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                            <Thickness x:Key="ExpanderChevronMargin">4,0,2,0</Thickness>
                            <Thickness x:Key="ExpanderContentPadding">0</Thickness>
                            <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
                        </Expander.Resources>
                        <Expander.Header>
                            <TextBlock Text="Default value syntax"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </Expander.Header>
                        <TextBlock Text="Plain text is used as-is. {Doc#|000} / {Batch#|000} insert a zero-padded document/batch counter, {Date|yyyy-MM-dd} / {Time|HH:mm:ss} insert a formatted timestamp (the part after | is a .NET format string — omit it for the defaults shown), {ProfileName} inserts the profile's name, and {AnyFieldName} inserts another field's value. Referencing a field that itself has a default value resolves to blank — defaults can't chain. Use {{ / }} for a literal brace."
                                   TextWrapping="Wrap"
                                   Classes="hint"
                                   Margin="2,4,2,2" />
                    </Expander>
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding SelectedField.IsLookup}">
                    <TextBlock Text="Options" Classes="field-label" Margin="0,8,0,0" />
                    <TextBlock Text="The display text is shown to the indexer; the export value is stored and sent to exporters."
                               TextWrapping="Wrap"
                               Classes="hint" />
                    <ItemsControl ItemsSource="{Binding SelectedField.LookupOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LookupOptionRow">
                                <Border Margin="0,0,0,8" Padding="8" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Display text (key)" Classes="field-label" />
                                        <TextBox Text="{Binding Key}" Watermark="e.g. Approved" />
                                        <TextBlock Text="Export value" Classes="field-label" />
                                        <TextBox Text="{Binding Value}" Watermark="e.g. A" />
                                        <Button Content="Remove option"
                                                Command="{Binding RemoveCommand}"
                                                HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add option"
                            Command="{Binding SelectedField.AddLookupOptionCommand}"
                            HorizontalAlignment="Stretch" />
                    <TextBlock Text="Default value (optional)" Classes="field-label" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding SelectedField.LookupOptions}"
                              SelectedItem="{Binding SelectedField.SelectedDefaultLookupOption}"
                              PlaceholderText="No default"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LookupOptionRow">
                                <TextBlock Text="{Binding Key}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Clear default"
                            Command="{Binding SelectedField.ClearLookupDefaultCommand}"
                            HorizontalAlignment="Right" />
                    <TextBlock Text="Auto-fill from another field (optional)" Classes="field-label" Margin="0,6,0,0" />
                    <TextBox Text="{Binding SelectedField.LookupKeyTemplate}"
                              Watermark="e.g. {Company Name}"
                              AcceptsReturn="False" />
                    <TextBlock Text="Resolves the same way as a Text field's default value, then matches the result against this field's display text above (case-insensitive) and fills in that option's export value. Falls back to the fixed default above when nothing matches."
                               TextWrapping="Wrap"
                               Classes="hint" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding SelectedField.IsScript}">
                    <TextBlock Text="This field's value is a single C# expression — other fields are read-only to it; its result becomes this field's value."
                               TextWrapping="Wrap"
                               Classes="hint"
                               Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Expression" Classes="field-label" Margin="0,4,0,0" VerticalAlignment="Bottom" />
                        <Button Grid.Column="1"
                                Content="Pop out"
                                Command="{Binding PopOutFieldScriptCommand}"
                                Classes="ghost"
                                FontSize="12"
                                Padding="8,3" />
                    </Grid>
                    <TextBox Text="{Binding SelectedField.ScriptExpression}"
                              Watermark="Fields[&quot;Company Name&quot;].Value.ToUpperInvariant()"
                              AcceptsReturn="True"
                              TextWrapping="NoWrap"
                              Classes="mono"
                              Height="70" />
                    <TextBlock Text="Fields[&quot;Other Field&quot;].Value reads another field. A later Script field (by position in the list on the left) can reference an earlier one's result — earlier fields resolve first. Document exposes the current document: FileName, FileExtension, PageCount, and Text (its full extracted OCR/PDF text)."
                               TextWrapping="Wrap"
                               Classes="hint" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                Content="Run test"
                                Command="{Binding RunFieldScriptCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Scripting help"
                                Command="{Binding ShowScriptingHelpCommand}"
                                Classes="ghost"
                                Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding SelectedField.IsButton}">
                    <TextBlock Text="Renders as a button in the review panel instead of a value control. Unlike a Script field's expression, its script is imperative and can write to any field — but only runs when someone clicks it, not automatically."
                               TextWrapping="Wrap"
                               Classes="hint"
                               Margin="0,8,0,0" />
                    <TextBlock Text="Button label" Classes="field-label" Margin="0,4,0,0" />
                    <TextBox Text="{Binding SelectedField.ButtonLabel}" Watermark="{Binding SelectedField.Name}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Script" Classes="field-label" Margin="0,4,0,0" VerticalAlignment="Bottom" />
                        <Button Grid.Column="1"
                                Content="Pop out"
                                Command="{Binding PopOutButtonScriptCommand}"
                                Classes="ghost"
                                FontSize="12"
                                Padding="8,3" />
                    </Grid>
                    <TextBox Text="{Binding SelectedField.ButtonScriptSource}"
                              Watermark="Fields[&quot;Total&quot;].Value = &quot;42&quot;;"
                              AcceptsReturn="True"
                              TextWrapping="NoWrap"
                              Classes="mono"
                              Height="90" />
                    <TextBlock Text="Timeout (seconds)" Classes="field-label" Margin="0,4,0,0" />
                    <NumericUpDown Value="{Binding SelectedField.ButtonTimeoutSeconds}" Minimum="1" Maximum="120" />
                    <TextBlock Text="Requires &quot;Allow profile scripts&quot; in Settings for real reviewers to click it — off by default, since it runs with full access to this computer. &quot;Run test&quot; below always works regardless, since it's a single-document action you take yourself."
                               TextWrapping="Wrap"
                               Classes="hint" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                Content="Run test"
                                Command="{Binding RunButtonFieldTestCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Scripting help"
                                Command="{Binding ShowScriptingHelpCommand}"
                                Classes="ghost"
                                Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
                <TextBlock Text="Extracted value" Classes="field-label" Margin="0,12,0,0" />
                <TextBlock Text="{Binding SelectedField.LiveFormat}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding SelectedField.HasLiveFormat}" />
                <TextBox Text="{Binding SelectedField.LiveValue}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MinHeight="72" />
                <TextBlock Text="{Binding SelectedField.ConfidenceDisplay}" Classes="field-label" />
                <TextBlock Text="{Binding Hint}"
                           TextWrapping="Wrap"
                           Classes="hint"
                           Margin="0,16,0,0" />
             </StackPanel>
             </Panel>
             </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Padding="16,8"
                Background="{DynamicResource Surface2Brush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush1}">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource InkSoftBrush}"
                       FontSize="12.5"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
