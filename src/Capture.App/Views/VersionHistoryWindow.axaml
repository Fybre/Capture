<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:Capture.App.Services"
        x:Class="Capture.App.Views.VersionHistoryWindow"
        Title="Version history"
        Icon="/Assets/capture.ico"
        Width="560"
        Height="620"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource GroundBrush}">
        <Border Grid.Row="0"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,18,28,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Version history" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Important changes in each version of Capture, newest first."
                           Classes="hint" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Entries" Margin="28,18,28,22">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:VersionHistoryEntry">
                        <Border Classes="card" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <TextBlock Text="{Binding Version}" Classes="section-title" VerticalAlignment="Center" />
                                    <Border Grid.Column="1"
                                            IsVisible="{Binding IsCurrent}"
                                            Background="{DynamicResource AccentWashBrush}"
                                            CornerRadius="9"
                                            Padding="8,1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="This version" FontSize="11" Foreground="{DynamicResource AccentStrongBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding DateDisplay}" Classes="hint" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Changes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="14,*">
                                                <TextBlock Text="•" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" LineHeight="19" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12"
                Background="{DynamicResource Surface2Brush}">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    MinWidth="88"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </Border>
    </Grid>
</Window>
