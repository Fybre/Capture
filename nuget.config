<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Manually-downloaded builds of native packages (Capture.Presidio.Binaries,
         Capture.Tesseract.Binaries — see README.md). Drop a newer .nupkg here and bump the matching
         PackageReference version in Capture.App.csproj to pick it up. Always available, no auth
         needed — the fallback when GitHub Packages below isn't configured. -->
    <add key="CaptureLocalFeed" value="local-nuget-feed" />
    <!-- Same packages, published by each source repo's CI (see README.md) — a permanent, GitHub-
         backed source instead of hand-downloading a workflow artifact. GitHub Packages requires an
         authenticated pull even for a public repo: set GITHUB_PACKAGES_USERNAME (your GitHub
         username) and GITHUB_PACKAGES_TOKEN (a PAT with read:packages) before restoring, or this
         source is simply skipped with no packages found — CaptureLocalFeed above still works either
         way. -->
    <add key="FybreGitHubPackages" value="https://nuget.pkg.github.com/Fybre/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <FybreGitHubPackages>
      <add key="Username" value="%GITHUB_PACKAGES_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </FybreGitHubPackages>
  </packageSourceCredentials>
</configuration>
