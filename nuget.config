<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Locally-downloaded build of https://github.com/Fybre/presidio-app until it's published to a
         real feed. Drop a newer Capture.Presidio.Binaries.*.nupkg here and bump the PackageReference
         version in Capture.App.csproj to pick it up. -->
    <add key="CapturePresidioLocal" value="local-nuget-feed" />
  </packageSources>
</configuration>
